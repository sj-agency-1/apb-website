---
import Element from '../ui/Element.astro';
import type { BlockSchema } from '../schemas/block';
import Container from '../structures/Container.astro';

// eslint-disable-next-line @typescript-eslint/no-empty-object-type
interface Props extends BlockSchema {}

const { text, ...rest } = Astro.props;
---

<Element class:list="banner" as="header" {...rest}>
  <Container>
    <Fragment set:html={text} />
  </Container>
</Element>

<style is:global>
  @layer ui {
    .banner {
      @apply relative flex w-full items-center bg-primary py-2.5 text-primary-foreground;

      .container {
        @apply flex items-center justify-center overflow-hidden bg-primary text-center text-sm leading-none text-primary-foreground;
      }
    }
  }
</style>
