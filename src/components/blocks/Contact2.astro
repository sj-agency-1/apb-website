---
import Channels from '@components/ui/Channels.astro';
import Form from '@components/ui/Form.astro';
import Heading from '@components/ui/Heading.astro';
import Image from '@components/ui/Image.astro';
import Paragraph from '@components/ui/Paragraph.astro';
import Socials from '@components/ui/Socials.astro';
import Tagline from '@components/ui/Tagline.astro';
import type { BlockSchema } from '@components/schemas/block';
import Container from '@components/structures/Container.astro';
import Group from '@components/structures/Group.astro';
import Prose from '@components/structures/Prose.astro';
import Section from '@components/structures/Section.astro';
import Split from '@components/structures/Split.astro';

// eslint-disable-next-line @typescript-eslint/no-empty-object-type
interface Props extends BlockSchema {}

const { depth = 2, tagline, heading, paragraph, content, channels, socials, form, image, ...rest } = Astro.props;
---

<Section class:list="contact-2" {...rest}>
  <Container>
    <Split>
      <Prose align="middle" class="max-w-xl">
        <Tagline text={tagline} />
        <Heading size="4xl" text={heading} {depth} />
        <Paragraph muted size="lg" text={paragraph} />
        <Fragment set:html={content} />
        <Channels {channels} />
        <Group>
          <Socials {socials} />
        </Group>
        <Form action="/thank-you" method="POST" {...form} />
      </Prose>
      <Image {...image} />
    </Split>
  </Container>
</Section>

<style is:global>
  @layer ui {
    .contact-2 {
      @apply relative w-full;

      .container {
        @apply flex flex-col gap-16;
      }

      .contact-2-segment {
        @apply flex flex-col items-start gap-8;
      }

      .contact-2-content {
        @apply flex max-w-screen-md flex-col gap-4;
      }

      .image {
        @apply rounded-md;
      }
    }
  }
</style>
