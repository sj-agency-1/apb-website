---
import type { HTMLAttributes } from 'astro/types';
import Heading from '../ui/Heading.astro';

interface Chapter {
  id: string;
  chapter: string;
  title: string;
  content: string;
}

interface Props extends HTMLAttributes<'div'> {
  chapters?: Chapter[];
}

const { chapters, ...rest } = Astro.props;
---

<div class="content" {...rest}>
  {
    chapters ? (
      chapters.map((chapter) => (
        <article class="content-chapter" id={chapter.id}>
          <div class="chapter-header">
            <span class="chapter-label">{chapter.chapter}</span>
            <Heading as="h3" size="2xl" text={chapter.title} />
          </div>
          <div class="chapter-body">
            <Fragment set:html={chapter.content} />
          </div>
        </article>
      ))
    ) : (
      <slot />
    )
  }
</div>
