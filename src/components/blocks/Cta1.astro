---
import Buttons from '@components/ui/Buttons.astro';
import Heading from '@components/ui/Heading.astro';
import Image from '@components/ui/Image.astro';
import Paragraph from '@components/ui/Paragraph.astro';
import Tagline from '@components/ui/Tagline.astro';
import type { BlockSchema } from '@components/schemas/block';
import Container from '@components/structures/Container.astro';
import Group from '@components/structures/Group.astro';
import Panel from '@components/structures/Panel.astro';
import Prose from '@components/structures/Prose.astro';
import Section from '@components/structures/Section.astro';

// eslint-disable-next-line @typescript-eslint/no-empty-object-type
interface Props extends BlockSchema {}

const { depth = 2, tagline, heading, paragraph, content, button, buttons, image } = Astro.props;
---

<Section class:list="cta-1">
  <Container>
    <Panel>
      <Prose align="center">
        <Tagline text={tagline} />
        <Heading size="5xl" as="h2" text={heading} {depth} />
        <Paragraph size="xl" text={paragraph} />
        <Fragment set:html={content} />
        <Group>
          <Buttons variant="primary" size="lg" {button} {buttons} />
        </Group>
      </Prose>
      <Image {...image} />
    </Panel>
  </Container>
</Section>

<style is:global>
  @layer ui {
    .cta-1 {
      .text {
        @apply text-pretty;
      }

      .image {
        @apply rounded-lg;
      }
    }
  }
</style>
