---
import type { HTMLAttributes } from 'astro/types';
import Card from '../ui/Card.astro';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import Button from '../ui/Button.astro';
import type { BluredDotsProps } from '../schemas/blured-dot';

interface Props extends HTMLAttributes<'div'> {
  variant?: 'default' | 'gradient' | 'primary';
  title: string;
  subtitle?: string;
  buttonText: string;
  buttonHref: string;
  size?: 'sm' | 'md' | 'lg';
  bluredDots?: BluredDotsProps;
}

const {
  variant = 'default',
  title,
  subtitle,
  buttonText,
  buttonHref,
  size = 'lg',
  bluredDots,
  class: className,
  ...rest
} = Astro.props;

// Blured dots configuration for primary variant (similar to AdvantagesList)
const primaryBluredDots: BluredDotsProps = [
  {
    color: 'FFAB24',
    top: 0,
    left: 0,
    width: 1,
    height: 1,
    shadowBlur: 100,
    shadowSpread: 15,
  },
  {
    color: '2470FF',
    top: 75,
    left: 75,
    width: 1,
    height: 1,
    shadowBlur: 100,
    shadowSpread: 10,
  },
  {
    color: '2470FF',
    bottom: 0,
    right: 0,
    width: 1,
    height: 1,
    shadowBlur: 200,
    shadowSpread: 30,
  },
];

// Map CTA variant to Card variant and additional classes
const variantConfig = {
  default: {
    cardVariant: 'default' as const,
    cardClass: 'bg-secondary',
    buttonVariant: 'primary' as const,
    buttonClass: '',
    bluredDots: undefined as BluredDotsProps | undefined,
  },
  gradient: {
    cardVariant: 'gradient' as const,
    cardClass: '',
    buttonVariant: 'primary' as const,
    buttonClass: '',
    bluredDots: undefined as BluredDotsProps | undefined,
  },
  primary: {
    cardVariant: 'default' as const,
    cardClass: '!bg-primary',
    buttonVariant: 'secondary' as const,
    buttonClass: '!bg-white !text-black hover:!bg-white/90',
    bluredDots: primaryBluredDots,
  },
};

const config = variantConfig[variant];
const effectiveBluredDots = bluredDots ?? config.bluredDots;
---

<Card
  variant={config.cardVariant}
  direction="row"
  size={size}
  bluredDots={effectiveBluredDots}
  class:list={[config.cardClass, className]}
  {...rest}
>
  <div class="flex flex-col gap-1 sm:gap-2 text-center lg:text-left">
    <Heading as="h3" size="md" text={title} class:list={[{ 'text-white!': variant === 'primary' }]} />
    {
      subtitle && (
        <Paragraph
          text={subtitle}
          muted={variant !== 'primary'}
          class:list={[{ 'text-white/80!': variant === 'primary' }]}
        />
      )
    }
  </div>
  <Button text={buttonText} href={buttonHref} variant={config.buttonVariant} size="md" class={config.buttonClass} />
</Card>
