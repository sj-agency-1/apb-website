---
import Heading from '@components/ui/Heading.astro';
import Icon from '@components/ui/Icon.astro';
import Paragraph from '@components/ui/Paragraph.astro';
import Tagline from '@components/ui/Tagline.astro';
import type { BlockSchema } from '@components/schemas/block';
import Container from '@components/structures/Container.astro';
import Prose from '@components/structures/Prose.astro';
import Section from '@components/structures/Section.astro';
import Stack from '@components/structures/Stack.astro';
import Writeup from '@components/structures/Writeup.astro';

// eslint-disable-next-line @typescript-eslint/no-empty-object-type
interface Props extends BlockSchema {}

const { depth = 2, tagline, heading, paragraph, cards, ...rest } = Astro.props;
---

<Section class:list="features-1" {...rest}>
  <Container>
    <Prose>
      <Tagline size="sm" text={tagline} />
      <Heading size="4xl" text={heading} {depth} />
      <Paragraph size="lg" text={paragraph} />
    </Prose>
    <Stack>
      {
        cards?.map(({ icon, heading, paragraph }) => (
          <Writeup>
            <Icon size="lg" name={icon} />
            <Heading depth={(depth + 1) as 3} as="h3" size="xl" text={heading} />
            <Paragraph text={paragraph} />
          </Writeup>
        ))
      }
    </Stack>
  </Container>
</Section>

<style is:global>
  @layer ui {
    .features-1 {
      .container {
        @apply flex flex-col gap-12;
      }

      .icon {
        @apply text-primary;
      }
    }
  }
</style>
