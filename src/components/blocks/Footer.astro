---
import Logo from '../ui/Logo.astro';
import Link from '../ui/Link.astro';
import Socials from '../ui/Socials.astro';
import FooterNav from '../structures/FooterNav.astro';
import type { FooterProps } from '../schemas/footer';

type Props = FooterProps;

const { logo, socials, copyright, navGroups } = Astro.props;
---

<footer class="footer">
  <div class="container mx-auto px-4">
    <div class="footer-content">
      <div class="footer-brand">
        {logo && <Logo {...logo} size="lg" />}
        {
          socials && socials.length > 0 && (
            <div class="footer-socials">
              <Socials socials={socials} />
            </div>
          )
        }
        {copyright && <p class="footer-copyright">{copyright}</p>}
        <p class="footer-legal-notice">
          Все материалы на сайте защищены авторским правом. Копирование и использование контента без письменного
          разрешения автора строго запрещено. Подробнее в <Link
            href="/content-policy"
            text="Политике использования контента"
            variant="primary"
            size="sm"
          />
        </p>
        <Link href="/sitemap" text="Карта сайта" variant="muted" size="sm" />
      </div>

      {navGroups && navGroups.length > 0 && <FooterNav groups={navGroups} />}
    </div>
  </div>
</footer>
