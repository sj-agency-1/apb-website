---
import Channels from '@components/ui/Channels.astro';
import Element from '@components/ui/Element.astro';
import Logo from '@components/ui/Logo.astro';
import Menus from '@components/ui/Menus.astro';
import { default as Paragraph } from '@components/ui/Paragraph.astro';
import Socials from '@components/ui/Socials.astro';
import type { BlockSchema } from '@components/schemas/block';
import Container from '@components/structures/Container.astro';
import Group from '@components/structures/Group.astro';
import Writeup from '@components/structures/Writeup.astro';

// eslint-disable-next-line @typescript-eslint/no-empty-object-type
interface Props extends BlockSchema {}

const {
  logo,
  // heading,
  paragraph,
  socials,
  channels,
  menus,
  // hours,
  // html,
  ...rest
} = Astro.props;
---

<Element class:list="footer" as="footer" {...rest}>
  <Container class:list="footer-container">
    <Writeup>
      <Logo size="sm" {...logo} />
      <Paragraph size="sm" text={paragraph} />
      <Group>
        <Socials size="sm" {socials} />
      </Group>
    </Writeup>
    <Element class:list="footer-channels">
      <Channels {channels} />
    </Element>
    <Menus size="sm" {menus} />
  </Container>
</Element>

<style is:global>
  @layer ui {
    .footer {
      @apply relative mt-auto w-full border-t bg-background;

      .container {
        @apply grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-12 py-12;
      }

      .writeup,
      .footer-channels {
        @apply max-w-xs;
      }

      .writeup .group {
        @apply mt-2;
      }

      .footer-channels {
        @apply flex flex-col gap-y-2;
      }
    }
  }
</style>
