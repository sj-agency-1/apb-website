---
// import Button from '@components/components/Button.astro'
import Button from '@components/ui/Button.astro';
// import Cart from '@components/components/Cart.astro'
import Element from '@components/ui/Element.astro';
import Links from '@components/ui/Links.astro';
import Logo from '@components/ui/Logo.astro';
import Menus from '@components/ui/Menus.astro';
// import Search from '@components/ui/Search.astro';
import Socials from '@components/ui/Socials.astro';
import Themer from '@components/ui/Themer.astro';
import LanguagePicker from '@components/ui/LanguagePicker.astro';
import type { BlockSchema } from '@components/schemas/block';
import Container from '@components/structures/Container.astro';
import Drawer from '@components/structures/Drawer.astro';

// eslint-disable-next-line @typescript-eslint/no-empty-object-type
interface Props extends BlockSchema {}

const { logo, links, menus, socials, themer, button } = Astro.props;
---

<Element class:list="header" as="header">
  <Container>
    <Element class:list="header-start">
      <Logo {...logo} />
      <Links size="sm" variant="muted" {links} />
    </Element>
    <Element class:list="header-end">
      <!-- {search && <Search show={search} variant="ghost" size="sm" />} -->
      <!-- {
        cart && (
          <Cart
            variant="ghost"
            size="sm"
          />
        )
      } -->
      {themer && <Themer show={themer} variant="ghost" size="sm" />}
      <Socials size="sm" {socials} />
      <LanguagePicker size="sm" />

      <Button size="sm" variant="outline" {...button} />
      <!-- <Button
        class:list="menu-button"
        as="label"
        for="sidebar-toggle"
        icon="menu-2"
        variant="ghost"
        size="sm"
      /> -->
      <Drawer id="header-drawer" icon="menu-2" size="sm">
        <Container>
          <Menus {menus} />
        </Container>
      </Drawer>
    </Element>
  </Container>
</Element>

<style is:global>
  @layer ui {
    .header {
      @apply sticky left-0 top-0 z-20 flex h-14 w-full items-center border-b bg-background;
      height: var(--header-height);

      &,
      & ~ * {
        --header-height: 3.5rem;
      }

      .container {
        @apply flex items-center gap-6;
      }

      .header-start {
        @apply flex items-center gap-6;

        .link {
          @apply max-lg:hidden;
        }
      }

      .header-home {
        @apply flex items-center gap-2;
      }

      .header-end {
        @apply ml-auto flex items-center gap-1;

        .social,
        .themer {
          @apply max-lg:hidden;
        }

        .menu-button {
          @apply lg:hidden;
        }
      }

      .drawer {
        @apply lg:hidden;

        .container {
          @apply flex w-full flex-col items-start gap-6 overflow-y-auto px-gutter pb-14 pt-8;
          @apply scrollbar scrollbar-track-transparent scrollbar-thumb-accent scrollbar-thumb-rounded-full scrollbar-w-2 hover:scrollbar-thumb-accent-hover;
        }
      }
    }
  }
</style>
