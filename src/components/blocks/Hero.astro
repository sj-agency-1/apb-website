---
import type { HTMLAttributes } from 'astro/types';
import Tagline from '../ui/Tagline.astro';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import Button from '../ui/Button.astro';
import Image from '../ui/Image.astro';

interface Props extends HTMLAttributes<'section'> {
  layout?: 'home' | 'page';
  tagline?: string;
  title?: string;
  subtitle?: string;
  cta?: {
    text: string;
    href: string;
  };
  backgroundImage?: string;
  foregroundImage?: string;
  globusImage?: string;
  globusTop?: string;
  globusRight?: string;
}

const {
  layout = 'page',
  tagline,
  title,
  subtitle,
  cta,
  backgroundImage,
  foregroundImage,
  globusImage,
  ...rest
} = Astro.props;

const isHome = layout === 'home';
---

<section class:list={['hero', { 'hero-home': isHome, 'hero-page': !isHome }]} {...rest}>
  {
    backgroundImage && (
      <div
        class="hero-background opacity-60"
        style={{
          backgroundImage: `url('${backgroundImage}')`,
          backgroundPosition: 'center top',
          backgroundSize: 'cover',
          backgroundRepeat: 'no-repeat',
        }}
      />
    )
  }
  <div class="container mx-auto px-4 h-full relative z-10">
    {
      isHome ? (
        <div class="hero-home-content">
          <div class="hero-slot-content">
            <slot />
          </div>
          {globusImage && (
            <div class="hero-globus">
              <Image src={globusImage} alt="" width={550} height={550} />
            </div>
          )}
        </div>
      ) : (
        <div class="hero-page-content">
          <slot>
            <div class="hero-text">
              {tagline && <Tagline text={tagline} size="md" />}
              {title && <Heading as="h1" size="5xl" text={title} />}
              {subtitle && <Paragraph text={subtitle} size="lg" muted />}
              {cta && (
                <div class="hero-cta">
                  <Button text={cta.text} href={cta.href} variant="primary" size="lg" />
                </div>
              )}
            </div>
            {foregroundImage && (
              <div class="hero-image">
                <Image src={foregroundImage} alt="" width={600} height={600} />
              </div>
            )}
          </slot>
        </div>
      )
    }
  </div>
</section>
