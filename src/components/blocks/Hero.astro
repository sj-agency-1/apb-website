---
import type { HTMLAttributes } from 'astro/types';
import Tagline from '../ui/Tagline.astro';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import Button from '../ui/Button.astro';
import Image from '../ui/Image.astro';

interface Props extends HTMLAttributes<'section'> {
  layout?: 'home' | 'page';
  tagline?: string;
  title?: string;
  subtitle?: string;
  cta?: {
    text: string;
    href: string;
  };
  backgroundImage?: string;
  foregroundImage?: string;
  globusImage?: string;
  globusTop?: string;
  globusRight?: string;
}

const {
  layout = 'page',
  tagline,
  title,
  subtitle,
  cta,
  backgroundImage,
  foregroundImage,
  globusImage,
  ...rest
} = Astro.props;

const isHome = layout === 'home';
---

<section class:list={['hero', { 'hero-home': isHome, 'hero-page': !isHome }]} {...rest}>
  {
    backgroundImage && (
      <div class="hero-background">
        <Image src={backgroundImage} alt="" width={1920} height={1080} />
      </div>
    )
  }
  <div class="container mx-auto px-4 h-full relative z-10">
    {
      isHome ? (
        <div class="hero-home-content">
          <div class="hero-slot-content">
            <slot />
          </div>
          {globusImage && (
            <div class="hero-globus">
              <Image src={globusImage} alt="" width={550} height={550} />
            </div>
          )}
        </div>
      ) : (
        <div class="hero-page-content">
          <slot>
            <div class="hero-text">
              {tagline && <Tagline text={tagline} size="md" />}
              {title && <Heading as="h1" size="5xl" text={title} />}
              {subtitle && <Paragraph text={subtitle} size="lg" muted />}
              {cta && (
                <div class="hero-cta">
                  <Button text={cta.text} href={cta.href} variant="primary" size="lg" />
                </div>
              )}
            </div>
            {foregroundImage && (
              <div class="hero-image">
                <Image src={foregroundImage} alt="" width={600} height={600} />
              </div>
            )}
          </slot>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    @apply relative overflow-hidden;
  }

  .hero-home {
    @apply h-[280px] lg:h-[380px];
  }

  .hero-page {
    @apply flex items-center py-8;
  }

  .hero-background {
    @apply absolute inset-0 z-0;
  }

  .hero-background :global(.image) {
    @apply w-full h-full object-cover opacity-60;
  }

  /* Home Layout Styles */
  .hero-home-content {
    @apply h-full flex items-center relative;
  }

  .hero-slot-content {
    @apply relative z-20 w-full lg:w-1/2 flex flex-col justify-center;
  }

  .hero-globus {
    @apply absolute z-10 pointer-events-none hidden lg:block;
    top: 20px;
    right: -100px;
  }

  .hero-globus :global(.image) {
    @apply w-[550px] h-[550px] object-contain;
  }

  /* Page Layout Styles */
  .hero-page-content {
    @apply grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center w-full;
  }

  .hero-text {
    @apply flex flex-col gap-4 lg:gap-6;
  }

  .hero-text :global(.heading) {
    @apply leading-tight;
  }

  .hero-cta {
    @apply mt-4;
  }

  .hero-image {
    @apply flex justify-center lg:justify-end;
  }

  .hero-image :global(.image) {
    @apply max-w-full h-auto max-h-[400px] lg:max-h-[500px] object-contain;
  }
</style>
