---
import Element from '@components/ui/Element.astro';
import Heading from '@components/ui/Heading.astro';
import Image from '@components/ui/Image.astro';
import Paragraph from '@components/ui/Paragraph.astro';
import type { BlockSchema } from '@components/schemas/block';
import Container from '@components/structures/Container.astro';
import Section from '@components/structures/Section.astro';
import Writeup from '@components/structures/Writeup.astro';

// eslint-disable-next-line @typescript-eslint/no-empty-object-type
interface Props extends BlockSchema {}

const { depth = 2, heading, paragraph, images, ...rest } = Astro.props;
---

<Section class:list="logos-1" {...rest}>
  <Container>
    <Writeup align="center">
      <Heading size="xl" text={heading} {depth} />
      <Paragraph size="sm" muted text={paragraph} />
    </Writeup>
    <Element class:list="logos-1-cards">
      {images?.map((image) => <Image {...image} />)}
    </Element>
  </Container>
</Section>

<style is:global>
  @layer ui {
    .logos-1 {
      .container {
        @apply flex flex-col items-center gap-8;
      }

      .logos-1-cards {
        @apply flex flex-wrap justify-center gap-8;
      }

      .image {
        @apply max-w-36;
      }
    }
  }
</style>
