---
import type { HTMLAttributes } from 'astro/types';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import Button from '../ui/Button.astro';
import Image from '../ui/Image.astro';

interface Props extends HTMLAttributes<'section'> {
  title: string;
  subtitle?: string;
  cta: {
    text: string;
    href: string;
  };
  ctaSubtext1?: string;
  ctaSubtext2?: string;
  backgroundImage?: string;
}

const { title, subtitle, cta, ctaSubtext1, ctaSubtext2, backgroundImage, ...rest } = Astro.props;
---

<section class="prefooter" {...rest}>
  {
    backgroundImage && (
      <div class="prefooter-background">
        <Image src={backgroundImage} alt="" width={1920} height={600} />
      </div>
    )
  }
  <div class="container mx-auto px-4 h-full">
    <div class="prefooter-content">
      <div class="prefooter-text">
        <Heading as="h2" size="4xl" text={title} />
        {subtitle && <Paragraph text={subtitle} size="lg" muted />}
      </div>
      <div class="prefooter-action">
        <Button
          text={cta.text}
          href={cta.href}
          variant="secondary"
          size="lg"
          class="prefooter-button bg-white! text-black! hover:bg-white/90!"
        />
        {
          (ctaSubtext1 || ctaSubtext2) && (
            <span class="prefooter-subtext">
              {ctaSubtext1}
              <br />
              {ctaSubtext2}
            </span>
          )
        }
      </div>
    </div>
  </div>
</section>
