---
import type { HTMLAttributes } from 'astro/types';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import Button from '../ui/Button.astro';

interface Props extends HTMLAttributes<'section'> {
  title: string;
  subtitle?: string;
  cta: {
    text: string;
    href: string;
  };
  ctaSubtext1?: string;
  ctaSubtext2?: string;
  backgroundImage?: string;
}

const { title, subtitle, cta, ctaSubtext1, ctaSubtext2, backgroundImage, ...rest } = Astro.props;
---

<section class="prefooter relative" {...rest}>
  {
    backgroundImage && (
      <div
        class="prefooter-background opacity-50"
        style={{
          backgroundImage: `url('${backgroundImage}')`,
          backgroundPosition: 'center top',
          backgroundSize: 'cover',
          backgroundRepeat: 'no-repeat',
        }}
      />
    )
  }
  <div class="container mx-auto px-4 h-full relative z-10">
    <div class="prefooter-content flex flex-col lg:flex-row w-full h-full">
      <div
        class="prefooter-left w-full lg:w-1/2 flex flex-col justify-center items-center text-center lg:items-start lg:text-left"
      >
        <div class="prefooter-text">
          <Heading as="h2" size="2xl" text={title} />
          {subtitle && <Paragraph text={subtitle} size="lg" muted />}
        </div>
        <div class="prefooter-action mt-6 w-full lg:w-auto">
          <Button
            text={cta.text}
            href={cta.href}
            variant="secondary"
            size="lg"
            class="prefooter-button bg-white! text-black! hover:bg-white/90!"
          />
          {
            (ctaSubtext1 || ctaSubtext2) && (
              <span class="prefooter-subtext">
                {ctaSubtext1}
                <br />
                {ctaSubtext2}
              </span>
            )
          }
        </div>
      </div>
      <div class="prefooter-right w-full lg:w-1/2"></div>
    </div>
  </div>
</section>
