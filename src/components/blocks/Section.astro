---
import type { HTMLAttributes } from 'astro/types';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';

interface Props extends HTMLAttributes<'section'> {
  id?: string;
  title?: string;
  subtitle?: string;
  variant?: 'default' | 'dark' | 'gradient' | undefined;
  size?: 'sm' | 'md' | 'lg' | undefined;
  container?: boolean;
}

const { id, title, subtitle, variant = 'default', size = 'md', container = true, ...rest } = Astro.props;

const sectionClasses = ['section', `variant-${variant}`, `size-${size}`];
---

<section class:list={sectionClasses} {id} {...rest}>
  {
    container ? (
      <div class="container mx-auto px-4">
        {(title || subtitle) && (
          <div class="section-header">
            {title && <Heading as="h2" size="4xl" text={title} />}
            {subtitle && <Paragraph text={subtitle} muted />}
          </div>
        )}
        <slot />
      </div>
    ) : (
      <>
        {(title || subtitle) && (
          <div class="section-header container mx-auto px-4">
            {title && <Heading as="h2" size="4xl" text={title} />}
            {subtitle && <Paragraph text={subtitle} muted />}
          </div>
        )}
        <slot />
      </>
    )
  }
</section>

<style>
  .section {
    @apply relative;
  }

  .section.size-sm {
    @apply py-8 lg:py-12;
  }

  .section.size-md {
    @apply py-12 lg:py-20;
  }

  .section.size-lg {
    @apply py-16 lg:py-28;
  }

  .section.variant-default {
    @apply bg-background;
  }

  .section.variant-dark {
    @apply bg-secondary/30;
  }

  .section.variant-gradient {
    @apply bg-gradient-to-b from-background to-secondary/20;
  }

  .section-header {
    @apply flex flex-col gap-3 mb-8 lg:mb-12 text-center;
  }
</style>
