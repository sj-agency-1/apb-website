---
import type { HTMLAttributes } from 'astro/types';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import BluredDot from '../ui/BluredDot.astro';
import type { BluredDotsProps } from '../schemas/blured-dot';

interface Props extends HTMLAttributes<'section'> {
  id?: string;
  title?: string;
  subtitle?: string;
  variant?: 'default' | 'dark' | 'gradient' | undefined;
  size?: 'sm' | 'md' | 'lg' | undefined;
  container?: boolean;
  bluredDots?: BluredDotsProps | undefined;
}

const { id, title, subtitle, variant = 'default', size = 'md', container = true, bluredDots, ...rest } = Astro.props;

const sectionClasses = ['section', `variant-${variant}`, `size-${size}`, { 'section-has-dots': bluredDots?.length }];
---

<section class:list={sectionClasses} {id} {...rest}>
  {bluredDots?.map((dot) => <BluredDot {...dot} />)}
  {
    container ? (
      <div class="container mx-auto px-6">
        {(title || subtitle) && (
          <div class="section-header">
            {title && <Heading as="h2" size="4xl" text={title} />}
            {subtitle && <Paragraph text={subtitle} muted />}
          </div>
        )}
        <slot />
      </div>
    ) : (
      <>
        {(title || subtitle) && (
          <div class="section-header container mx-auto px-6">
            {title && <Heading as="h2" size="4xl" text={title} />}
            {subtitle && <Paragraph text={subtitle} muted />}
          </div>
        )}
        <slot />
      </>
    )
  }
</section>
