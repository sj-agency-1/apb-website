---
import type { HTMLAttributes } from 'astro/types';
import TableOfContents from '../structures/TableOfContents.astro';
import BlogList from '../structures/BlogList.astro';
import Card from '../ui/Card.astro';
import type { TocItem } from '../structures/TableOfContents.astro';
import type { BlogItem } from '../structures/BlogList.astro';

interface Props extends HTMLAttributes<'aside'> {
  tocItems?: TocItem[];
  blogItems?: BlogItem[];
  blogTitle?: string;
  activeId?: string;
  ctaText?: string;
}

const { tocItems, blogItems, blogTitle, activeId, ctaText = 'Подробнее', ...rest } = Astro.props;
---

<aside class="sidebar" {...rest}>
  {
    tocItems && tocItems.length > 0 && (
      <Card blur variant="outline" size="md" class="sidebar-card">
        {activeId ? <TableOfContents items={tocItems} activeId={activeId} /> : <TableOfContents items={tocItems} />}
      </Card>
    )
  }

  {
    blogItems && blogItems.length > 0 && (
      <Card blur variant="outline" size="md" class="sidebar-card">
        {blogTitle && <h4 class="sidebar-title">{blogTitle}</h4>}
        <BlogList items={blogItems} variant="vertical" ctaText={ctaText} />
      </Card>
    )
  }

  <slot />
</aside>

<style>
  .sidebar {
    @apply flex flex-col gap-6;
    scrollbar-width: none;
  }

  .sidebar-card {
    @apply border-border/50;
  }

  .sidebar-title {
    @apply text-sm font-semibold text-heading uppercase tracking-wider mb-4;
  }

  @media (min-width: 1024px) {
    .sidebar {
      position: sticky;
      top: 6rem;
      align-self: flex-start;
    }
  }
</style>


