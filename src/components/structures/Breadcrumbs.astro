---
import type { HTMLAttributes } from 'astro/types';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

export interface BreadcrumbItem {
  text: string;
  href?: string;
}

interface Props extends HTMLAttributes<'nav'> {
  items: BreadcrumbItem[];
}

const { items, ...rest } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Prepend home item
const allItems: BreadcrumbItem[] = [{ text: t('breadcrumbs.home'), href: `/${lang}/` }, ...items];
---

<nav class="breadcrumbs" aria-label="Breadcrumb" {...rest}>
  <ol class="breadcrumbs-list">
    {
      allItems.map((item, index) => {
        const isLast = index === allItems.length - 1;
        return (
          <li class="breadcrumbs-item">
            {item.href && !isLast ? (
              <a href={item.href} class="breadcrumbs-link">
                {item.text}
              </a>
            ) : (
              <span class="breadcrumbs-current" aria-current={isLast ? 'page' : undefined}>
                {item.text}
              </span>
            )}
            {!isLast && <span class="breadcrumbs-separator">/</span>}
          </li>
        );
      })
    }
  </ol>
</nav>
