---
// Sets a max-width, padding and centers the content

import type { HTMLAttributes, HTMLTag } from 'astro/types';
import Element from '../ui/Element.astro';

interface Props extends HTMLAttributes<'div'> {
  as?: HTMLTag;
}

const { ...rest } = Astro.props;
---

<Element class:list="container" {...rest}>
  <slot />
</Element>

<style is:global>
  @layer ui {
    .container {
      @apply mx-auto w-full max-w-screen-2xl px-4 sm:px-8;
    }
  }
</style>
