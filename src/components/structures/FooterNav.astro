---
import Link from '../ui/Link.astro';
import type { LinkProps } from '../schemas/link';

interface Props {
  groups: {
    links: LinkProps[];
  }[];
}

const { groups } = Astro.props;
---

<nav class="footer-nav">
  {
    groups.map((group) => (
      <ul class="nav-group">
        {group.links.map((link) => (
          <li>
            <Link {...link} variant="muted" size="sm" />
          </li>
        ))}
      </ul>
    ))
  }
</nav>
