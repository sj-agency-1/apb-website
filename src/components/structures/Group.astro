---
// Group buttons and similar components

import type { HTMLAttributes, HTMLTag } from 'astro/types';
import Element from '../ui/Element.astro';

interface Props extends HTMLAttributes<'div'> {
  as?: HTMLTag;
}

const { ...rest } = Astro.props;
---

<Element class:list="group" {...rest}>
  <slot />
</Element>

<style is:global>
  @layer ui {
    .group {
      @apply flex flex-wrap justify-stretch gap-2;
    }
  }
</style>
