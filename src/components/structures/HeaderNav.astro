---
import Link from '../ui/Link.astro';
import type { LinkProps } from '../schemas/link';

interface Props {
  links: LinkProps[];
}

const { links } = Astro.props;
---

<nav class="header-nav">
  <ul class="list">
    {
      links.map((link) => (
        <li class="item mt-0!">
          <Link {...link} />
        </li>
      ))
    }
  </ul>
</nav>
