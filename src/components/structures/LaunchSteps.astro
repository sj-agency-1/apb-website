---
import type { LaunchStepsProps } from '../schemas/launch-steps';
import Image from '../ui/Image.astro';
import Button from '../ui/Button.astro';

interface CtaStep {
  title: string;
  subtitle?: string;
  buttonText: string;
  buttonHref: string;
}

interface Props extends LaunchStepsProps {
  ctaStep?: CtaStep;
  stepLabel?: string;
}

const { items, ctaStep, stepLabel = 'Этап' } = Astro.props;
const totalSteps = items.length;
---

<div class="launch-steps">
  <div class="timeline-line"></div>
  {
    items.map((item, index) => (
      <div class={`launch-step ${index % 2 === 0 ? 'left' : 'right'}`}>
        <div class="step-content">
          <div class="step-icon">
            <Image src={item.icon} alt={item.title} width={80} height={80} />
          </div>
          <div class="step-text">
            <span class="step-number">
              {stepLabel} {item.step}
            </span>
            <h3 class="step-title">{item.title}</h3>
            <p class="step-description">{item.description}</p>
          </div>
        </div>
        <div class="timeline-dot" />
      </div>
    ))
  }
  {
    ctaStep && (
      <div class={`launch-step cta-step ${totalSteps % 2 === 0 ? 'left' : 'right'}`}>
        <div class="step-content-cta">
          <div class="step-text-cta">
            <h3 class="step-title-cta">{ctaStep.title}</h3>
            {ctaStep.subtitle && <p class="step-description-cta">{ctaStep.subtitle}</p>}
          </div>
          <Button
            text={ctaStep.buttonText}
            href={ctaStep.buttonHref}
            variant="secondary"
            size="lg"
            class="cta-button"
          />
        </div>
        <div class="timeline-dot cta-dot" />
      </div>
    )
  }
</div>
