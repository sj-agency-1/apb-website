---
import type { LaunchStepsProps } from '../schemas/launch-steps';
import Image from '../ui/Image.astro';
import Button from '../ui/Button.astro';

interface CtaStep {
  title: string;
  subtitle?: string;
  buttonText: string;
  buttonHref: string;
}

interface Props extends LaunchStepsProps {
  ctaStep?: CtaStep;
  stepLabel?: string;
}

const { items, ctaStep, stepLabel = 'Этап' } = Astro.props;
const totalSteps = items.length;
---

<div class="launch-steps">
  <div class="timeline-line"></div>
  {
    items.map((item, index) => (
      <div class={`launch-step ${index % 2 === 0 ? 'left' : 'right'}`}>
        <div class="step-content">
          <div class="step-icon">
            <Image src={item.icon} alt={item.title} width={60} height={60} />
          </div>
          <div class="step-text">
            <span class="step-number">
              {stepLabel} {item.step}
            </span>
            <h3 class="step-title">{item.title}</h3>
            <p class="step-description">{item.description}</p>
          </div>
        </div>
        <div class="timeline-dot" />
      </div>
    ))
  }
  {
    ctaStep && (
      <div class={`launch-step cta-step ${totalSteps % 2 === 0 ? 'left' : 'right'}`}>
        <div class="step-content-cta">
          <div class="step-text-cta">
            <h3 class="step-title-cta">{ctaStep.title}</h3>
            {ctaStep.subtitle && <p class="step-description-cta">{ctaStep.subtitle}</p>}
          </div>
          <Button
            text={ctaStep.buttonText}
            href={ctaStep.buttonHref}
            variant="secondary"
            size="lg"
            class="cta-button"
          />
        </div>
        <div class="timeline-dot cta-dot" />
      </div>
    )
  }
</div>

<style>
  .launch-steps {
    @apply relative flex flex-col gap-0;
    padding-block: 2rem;
  }

  .timeline-line {
    @apply absolute left-1/2 top-0 bottom-0 w-px bg-muted -translate-x-1/2 hidden lg:block;
  }

  .launch-step {
    @apply relative flex items-center;
    min-height: 140px;
  }

  .timeline-dot {
    @apply absolute left-1/2 top-1/2 w-3 h-3 rounded-full bg-accent -translate-x-1/2 -translate-y-1/2 z-10 hidden lg:block;
  }

  .cta-dot {
    @apply bg-white;
  }

  .step-content {
    @apply flex items-start gap-4 p-5 rounded-2xl bg-gradient-to-br from-secondary/60 to-transparent border border-border/30 w-full lg:w-[calc(50%-2rem)];
  }

  .step-content-cta {
    @apply flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 p-6 rounded-2xl bg-primary w-full lg:w-[calc(50%-2rem)];
  }

  .launch-step.left .step-content,
  .launch-step.left .step-content-cta {
    @apply lg:mr-auto;
  }

  .launch-step.right .step-content,
  .launch-step.right .step-content-cta {
    @apply lg:ml-auto;
  }

  .step-icon {
    @apply flex items-center justify-center w-14 h-14 rounded-xl bg-secondary flex-shrink-0;
  }

  .step-icon :global(.image) {
    @apply w-8 h-8 object-contain;
  }

  .step-text {
    @apply flex flex-col gap-1;
  }

  .step-text-cta {
    @apply flex flex-col gap-1;
  }

  .step-number {
    @apply text-xs text-muted-foreground uppercase tracking-wider;
  }

  .step-number-cta {
    @apply text-xs text-white/70 uppercase tracking-wider;
  }

  .step-title {
    @apply text-base font-bold text-heading font-heading;
  }

  .step-title-cta {
    @apply text-lg font-bold text-white font-heading;
  }

  .step-description {
    @apply text-sm text-foreground leading-relaxed;
  }

  .step-description-cta {
    @apply text-sm text-white/80 leading-relaxed;
  }

  .cta-button {
    @apply bg-white text-black hover:bg-white/90 flex-shrink-0;
  }
</style>
