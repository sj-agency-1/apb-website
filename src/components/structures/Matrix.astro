---
// Places items like cards in a grid

import type { HTMLAttributes, HTMLTag } from 'astro/types';
import Element from '../ui/Element.astro';

interface Props extends HTMLAttributes<'div'> {
  as?: HTMLTag;
  size?: 'sm' | 'md' | 'lg' | undefined;
}

const { size = 'md', ...rest } = Astro.props;
---

<Element class:list="matrix" {size} {...rest}>
  <slot />
</Element>

<style is:global>
  @layer ui {
    .matrix {
      @apply relative grid w-full gap-5;

      &.size-sm {
        @apply grid-cols-[repeat(auto-fill,minmax(12rem,1fr))];
      }

      &.size-md {
        @apply grid-cols-[repeat(auto-fill,minmax(16rem,1fr))];
      }

      &.size-lg {
        @apply grid-cols-[repeat(auto-fill,minmax(20rem,1fr))];
      }
    }
  }
</style>
