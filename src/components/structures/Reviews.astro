---
import type { ReviewProps } from '../schemas/review';
import Image from '../ui/Image.astro';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  reviews: ReviewProps[];
  title?: string;
  subtitle?: string;
  moreText?: string;
  moreHref?: string;
  showMoreText?: string;
  showLessText?: string;
}

const { reviews, title, subtitle, showMoreText = 'Show more', showLessText = 'Show less' } = Astro.props;
---

<div class="reviews-container">
  <div class="flex flex-col md:flex-row justify-between items-end mb-8 lg:mb-12 gap-4">
    <div class="flex flex-col gap-3 text-left">
      {title && <Heading as="h2" size="4xl" text={title} />}
      {subtitle && <Paragraph text={subtitle} muted />}
    </div>
    <div class="hidden lg:flex gap-2 shrink-0">
      <Button variant="outline" class="prev-review px-3" aria-label="Previous review">
        <div class="flex items-center justify-center">
          <Icon name="arrow-left" />
        </div>
      </Button>
      <Button variant="outline" class="next-review px-3" aria-label="Next review">
        <div class="flex items-center justify-center">
          <Icon name="arrow-right" />
        </div>
      </Button>
    </div>
  </div>

  <div class="reviews-carousel cursor-grab active:cursor-grabbing">
    <div class="reviews-track">
      {
        reviews.map((review, index) => (
          <div class="review-card select-none flex flex-col">
            <div class="review-avatar shrink-0 mb-4">
              {review.avatar ? (
                <Image src={review.avatar} alt={review.name} width={100} height={100} />
              ) : (
                <div class={`avatar-placeholder ${review.sex}`} />
              )}
            </div>
            <div class="review-meta mb-3">
              <h4 class="review-name">
                {review.name}, {review.age} лет
              </h4>
              <p class="review-location">
                {review.location}
                {review.translated && ' *Перевод с оригинала'}
              </p>
            </div>
            <div class="review-content grow flex flex-col">
              <p class="review-text line-clamp-10 min-h-[15em]" id={`home-review-text-${index}`}>
                {review.text}
              </p>
              <button
                class="text-primary text-sm font-medium mt-2 hover:underline focus:outline-none toggle-review-btn hidden self-start items-center gap-1"
                data-target={`home-review-text-${index}`}
                data-text-more={showMoreText}
                data-text-less={showLessText}
              >
                {showMoreText}
                <Icon name="chevron-down" class="w-4 h-4 inline align-middle ml-1" />
              </button>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="lg:hidden flex gap-2 shrink-0">
    <Button variant="outline" class="prev-review-bottom px-3" aria-label="Previous review">
      <div class="flex items-center justify-center">
        <Icon name="arrow-left" />
      </div>
    </Button>
    <Button variant="outline" class="next-review-bottom px-3" aria-label="Next review">
      <div class="flex items-center justify-center">
        <Icon name="arrow-right" />
      </div>
    </Button>
  </div>
</div>

<script>
  function initReviews() {
    const carousels = document.querySelectorAll('.reviews-carousel');

    carousels.forEach((carousel) => {
      const container = carousel.closest('.reviews-container');
      if (!container) return;

      // Check if already initialized
      if ((carousel as unknown as { __reviewsInitialized: boolean }).__reviewsInitialized) return;
      (carousel as unknown as { __reviewsInitialized: boolean }).__reviewsInitialized = true;

      const prevBtn = container.querySelector('.prev-review');
      const nextBtn = container.querySelector('.next-review');
      const prevBtnBottom = container.querySelector('.prev-review-bottom');
      const nextBtnBottom = container.querySelector('.next-review-bottom');

      if (prevBtn && nextBtn) {
        prevBtn.addEventListener('click', () => {
          carousel.scrollBy({ left: -400, behavior: 'smooth' });
        });

        nextBtn.addEventListener('click', () => {
          carousel.scrollBy({ left: 400, behavior: 'smooth' });
        });
      }

      if (prevBtnBottom && nextBtnBottom) {
        prevBtnBottom.addEventListener('click', () => {
          carousel.scrollBy({ left: -400, behavior: 'smooth' });
        });

        nextBtnBottom.addEventListener('click', () => {
          carousel.scrollBy({ left: 400, behavior: 'smooth' });
        });
      }

      // Drag to scroll
      let isDown = false;
      let startX: number;
      let scrollLeft: number;

      const c = carousel as HTMLElement;

      // View More/Less logic
      const toggleBtns = container.querySelectorAll<HTMLElement>('.toggle-review-btn');
      toggleBtns.forEach((btn) => {
        const targetId = btn.dataset.target;
        if (!targetId) return;
        const textEl = document.getElementById(targetId);
        if (!textEl) return;

        // Check overflow
        const checkOverflow = () => {
          if (textEl.scrollHeight > textEl.clientHeight) {
            btn.classList.remove('hidden');
            btn.classList.add('flex');
          }
        };

        // Run check
        checkOverflow();
        // Also run on window resize just in case
        window.addEventListener('resize', checkOverflow);

        btn.addEventListener('click', () => {
          // If check for line-clamp-[10] or line-clamp-10. Tailwind usually compiles to a specific class.
          // Since I used line-clamp-[10] in HTML, I should check that.
          // Or just check if it contains the class.
          // Note: line-clamp-[10] might be compiled to something else if using arbitrary values?
          // Usually it stays as a class name if using JIT.
          const isExpanded = !textEl.classList.contains('line-clamp-[10]');

          if (isExpanded) {
            textEl.classList.add('line-clamp-[10]');
            // Collapse
            const textMore = btn.dataset.textMore || 'Show more';
            // Use SVG directly
            btn.innerHTML = `${textMore} <svg class="w-4 h-4 inline align-middle ml-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>`;
          } else {
            textEl.classList.remove('line-clamp-[10]');
            // Expand
            const textLess = btn.dataset.textLess || 'Show less';
            btn.innerHTML = `${textLess} <svg class="w-4 h-4 inline align-middle ml-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>`;
          }
        });
      });

      c.addEventListener('mousedown', (e) => {
        isDown = true;
        c.classList.add('active');
        startX = e.clientX - c.getBoundingClientRect().left;
        scrollLeft = c.scrollLeft;
      });

      c.addEventListener('mouseleave', () => {
        isDown = false;
        c.classList.remove('active');
      });

      c.addEventListener('mouseup', () => {
        isDown = false;
        c.classList.remove('active');
      });

      c.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.clientX - c.getBoundingClientRect().left;
        const walk = (x - startX) * 2; // scroll-fast
        c.scrollLeft = scrollLeft - walk;
      });
    });
  }

  // Run on initial load
  initReviews();

  // Run on view transitions
  document.addEventListener('astro:page-load', initReviews);
</script>
