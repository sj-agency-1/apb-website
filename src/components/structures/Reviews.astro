---
import type { ReviewProps } from '../schemas/review';
import Image from '../ui/Image.astro';

interface Props {
  reviews: ReviewProps[];
  moreText?: string;
  moreHref?: string;
}

const { reviews } = Astro.props;
---

<div class="reviews-carousel">
  <div class="reviews-track">
    {
      reviews.map((review) => (
        <div class="review-card">
          <div class="review-avatar">
            {review.avatar ? (
              <Image src={review.avatar} alt={review.name} width={100} height={100} />
            ) : (
              <div class={`avatar-placeholder ${review.sex}`} />
            )}
          </div>
          <div class="review-meta">
            <h4 class="review-name">
              {review.name}, {review.age} лет
            </h4>
            <p class="review-location">
              {review.location}
              {review.translated && ' *Перевод с оригинала'}
            </p>
          </div>
          <p class="review-text">{review.text}</p>
        </div>
      ))
    }
  </div>
</div>

<style>
  .reviews-carousel {
    @apply relative overflow-x-auto pb-4 -mx-4 px-4;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .reviews-carousel::-webkit-scrollbar {
    display: none;
  }

  .reviews-track {
    @apply flex gap-6;
    width: max-content;
  }

  .review-card {
    @apply flex flex-col items-start text-left gap-4 p-6 rounded-2xl bg-secondary border border-border/30 w-[410px] flex-shrink-0;
  }

  .review-avatar {
    @apply w-[100px] h-[100px] rounded-xl overflow-hidden flex-shrink-0;
  }

  .review-avatar :global(.image) {
    @apply w-full h-full object-cover;
  }

  .avatar-placeholder {
    @apply w-full h-full;
  }

  .avatar-placeholder.female {
    @apply bg-gradient-to-br from-orange-400 to-orange-600;
  }

  .avatar-placeholder.male {
    @apply bg-gradient-to-br from-blue-400 to-blue-600;
  }

  .review-meta {
    @apply flex flex-col gap-0.5;
  }

  .review-name {
    @apply text-base font-bold text-heading;
  }

  .review-location {
    @apply text-xs text-muted-foreground;
  }

  .review-text {
    @apply text-sm text-foreground leading-relaxed;
  }
</style>
