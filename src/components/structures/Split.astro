---
// Splits content into two columns with optional alignment

import type { HTMLAttributes, HTMLTag } from 'astro/types';
import Element from '../ui/Element.astro';

interface Props extends HTMLAttributes<'div'> {
  as?: HTMLTag;
  align?: 'start' | 'center' | 'sticky';
}

const { ...rest } = Astro.props;
---

<Element class:list="split" {...rest}>
  <slot />
</Element>

<style is:global>
  @layer ui {
    .split {
      @apply grid gap-x-4 gap-y-16 sm:gap-x-8 lg:grid-cols-2;
    }

    .align-start {
      @apply items-start;
    }

    .align-center {
      @apply items-center;
    }

    .align-sticky {
      @apply items-start lg:[&>*]:sticky lg:[&>*]:top-sticky-16;
    }
  }
</style>
