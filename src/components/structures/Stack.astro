---
// Places items like cards in a horizontal or vertical stack

import type { HTMLAttributes, HTMLTag } from 'astro/types';
import Element from '../ui/Element.astro';

interface Props extends HTMLAttributes<'div'> {
  as?: HTMLTag;
}

const { ...rest } = Astro.props;
---

<Element class:list="stack" {...rest}>
  <slot />
</Element>

<style is:global>
  @layer ui {
    .stack {
      @apply relative grid w-full auto-cols-fr items-start gap-x-8 gap-y-8 lg:grid-flow-col lg:gap-x-16;
    }
  }
</style>
