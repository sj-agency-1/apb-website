---
import { Icon } from 'astro-icon/components';
import Accordion from '../ui/Accordion.astro';

interface StepItem {
  step: number;
  icon: string;
  title: string;
  oldPrice: number | string;
  newPrice: number | string;
  description: string;
  purpose: string;
  faq: { question: string; answer: string }[];
}

interface Props {
  items: StepItem[];
  stepLabel?: string;
  descriptionLabel?: string;
  purposeLabel?: string;
  faqLabel?: string;
  priceLabel?: string;
  promoPriceLabel?: string;
}

const {
  items,
  stepLabel = 'Этап',
  descriptionLabel = 'Описание',
  purposeLabel = 'Для чего этот этап',
  faqLabel = 'Часто задаваемые Вопросы',
  priceLabel = 'Стоимость',
  promoPriceLabel = 'Стоимость по промокоду',
} = Astro.props;
---

<div class="steps-accordion">
  {
    items.map((item) => (
      <details class="step-item">
        <summary class="step-header">
          <div class="step-icon">
            <Icon name={item.icon} class="h-6 w-6 text-black" />
          </div>
          <div class="step-info">
            <span class="step-label">
              {stepLabel} {item.step}
            </span>
            <h3 class="step-title">{item.title}</h3>
          </div>
          <div class="step-prices">
            {item.oldPrice && (
              <span class="step-old-price">${typeof item.oldPrice === 'number' ? item.oldPrice : item.oldPrice}</span>
            )}
            {item.newPrice && (
              <span class="step-new-price">
                {typeof item.newPrice === 'number' ? `$${item.newPrice}` : item.newPrice}
              </span>
            )}
          </div>
          <div class="step-toggle">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </div>
        </summary>
        <div class="step-content">
          <div class="step-section">
            <h4 class="step-section-title">{descriptionLabel}</h4>
            <p class="step-section-text">{item.description}</p>
          </div>
          <div class="step-section">
            <h4 class="step-section-title">{purposeLabel}</h4>
            <p class="step-section-text">{item.purpose}</p>
          </div>
          <div class="step-prices-detail">
            <div class="price-item">
              <span class="price-label">{priceLabel}</span>
              <span class="price-value old">${typeof item.oldPrice === 'number' ? item.oldPrice : item.oldPrice}</span>
            </div>
            <div class="price-item">
              <span class="price-label">{promoPriceLabel}</span>
              <span class="price-value new">
                {typeof item.newPrice === 'number' ? `$${item.newPrice}` : item.newPrice}
              </span>
            </div>
          </div>
          {item.faq && item.faq.length > 0 && (
            <div class="step-faq">
              <h4 class="step-section-title">{faqLabel}</h4>
              <Accordion items={item.faq.map((f) => ({ question: f.question, answer: f.answer }))} />
            </div>
          )}
        </div>
      </details>
    ))
  }
</div>
