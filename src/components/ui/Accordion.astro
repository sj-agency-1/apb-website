---
import type { HTMLAttributes } from 'astro/types';
import Element from './Element.astro';
import Icon from './Icon.astro';

export interface AccordionItem {
  question: string;
  answer: string;
}

interface Props extends HTMLAttributes<'div'> {
  items: AccordionItem[];
}

const { items, ...rest } = Astro.props;
---

<Element class:list="accordion" {...rest}>
  {
    items.map((item) => (
      <details class="accordion-item" name="accordion">
        <summary class="accordion-trigger">
          <span class="accordion-title">{item.question}</span>
          <Icon name="chevron-down" class="accordion-icon" />
        </summary>
        <div class="accordion-content">
          <div class="accordion-content-inner">
            <p set:html={item.answer} />
          </div>
        </div>
      </details>
    ))
  }
</Element>

<style is:global>
  @layer ui {
    .accordion {
      @apply flex flex-col gap-3;
    }

    .accordion-item {
      @apply rounded-xl bg-secondary overflow-hidden;

      &[open] {
        .accordion-icon {
          @apply rotate-180;
        }

        .accordion-content {
          @apply grid-rows-[1fr] opacity-100;
        }
      }
    }

    .accordion-trigger {
      @apply flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left text-heading font-medium transition-colors hover:bg-secondary-hover list-none;

      &::-webkit-details-marker {
        display: none;
      }
    }

    .accordion-title {
      @apply text-base font-medium;
    }

    .accordion-icon {
      @apply text-muted-foreground transition-transform duration-300 ease-in-out flex-shrink-0;
    }

    .accordion-content {
      @apply grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-in-out;
    }

    .accordion-content-inner {
      @apply overflow-hidden px-5 pb-0;
    }

    .accordion-item[open] .accordion-content-inner {
      @apply pb-5;
    }

    .accordion-content p {
      @apply leading-relaxed text-foreground;
    }
  }
</style>
