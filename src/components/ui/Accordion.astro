---
import type { HTMLAttributes } from 'astro/types';
import Element from './Element.astro';
import Icon from './Icon.astro';

export interface AccordionItem {
  question: string;
  answer: string;
}

interface Props extends HTMLAttributes<'div'> {
  items: AccordionItem[];
  openedItemsByDefault?: number[];
}

const { items, openedItemsByDefault = [], ...rest } = Astro.props;
---

<Element class:list="accordion" {...rest}>
  {
    items.map((item, idx) => (
      <details
        class="accordion-item"
        {...(openedItemsByDefault && openedItemsByDefault.includes(idx) ? { open: true } : {})}
      >
        <summary class="accordion-trigger">
          <span class="accordion-title">{item.question}</span>
          <Icon name="chevron-down" class="accordion-icon" />
        </summary>
        <div class="accordion-content">
          <div class="accordion-content-inner">
            <p set:html={item.answer} />
          </div>
        </div>
      </details>
    ))
  }
</Element>
