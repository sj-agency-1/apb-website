---
import type { ComponentProps } from 'astro/types';
import Image from './Image.astro';

interface Props extends ComponentProps<typeof Image> {
  size?: 'sm' | 'md' | 'lg' | undefined;
}

const { size = 'md', ...rest } = Astro.props;
---

<Image
  class:list={[
    'avatar',
    {
      [`size-${size}`]: size,
    },
  ]}
  {...rest}
/>
