---
import type { HTMLAttributes } from 'astro/types';
import Element from './Element.astro';
import Icon from './Icon.astro';

interface Props extends HTMLAttributes<'button'>, Omit<HTMLAttributes<'a'>, 'type'>, HTMLAttributes<'label'> {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'flat' | undefined;
  size?: 'sm' | 'md' | 'lg' | undefined;
  text?: string | undefined;
  icon?: string | undefined;
  href?: string | undefined;
}

const {
  variant = 'primary',
  size = 'md',
  text,
  icon,
  href,
  target = href?.startsWith('http') ? '_blank' : undefined,
  ...rest
} = Astro.props;
---

<Element
  class:list={['button']}
  as={href ? 'a' : rest.for ? 'label' : 'button'}
  {variant}
  {size}
  {href}
  {target}
  {...rest}
>
  <Element as="span">
    <Fragment set:html={text} />
    <slot />
  </Element>
  <Icon name={icon} />
</Element>

<style is:global>
  @layer ui {
    .button {
      @apply inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-xl text-sm font-medium leading-none transition-colors;
      @apply focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background;
      @apply disabled:pointer-events-none disabled:opacity-50;

      &.size-sm {
        @apply h-9 min-h-9 min-w-9 px-3 text-sm;
      }

      &.size-md {
        @apply h-11 min-h-11 min-w-11 px-5 text-base;
      }

      &.size-lg {
        @apply h-12 min-h-12 min-w-12 px-6 text-lg;
      }

      &.variant-primary {
        @apply bg-primary text-primary-foreground hover:bg-primary-hover;
      }

      &.variant-secondary {
        @apply bg-secondary text-secondary-foreground hover:bg-secondary-hover;
      }

      &.variant-outline {
        @apply border border-primary bg-transparent text-white hover:bg-primary hover:text-primary-foreground;
      }

      &.variant-ghost {
        @apply bg-transparent text-foreground hover:bg-secondary;
      }

      &.variant-flat {
        @apply bg-primary/15 text-primary hover:bg-primary/25;
      }

      .icon {
        @apply first:last:absolute;
      }

      span {
        @apply text-inherit;
      }

      &.reverse {
        .icon {
          @apply order-last;
        }
      }
    }
  }
</style>
