---
import type { HTMLAttributes } from 'astro/types';
import Element from './Element.astro';
import BluredDot from './BluredDot.astro';
import type { BluredDotsProps } from '../schemas/blured-dot';

interface Props extends HTMLAttributes<'div'> {
  variant?: 'default' | 'gradient' | 'outline' | 'cta' | undefined;
  size?: 'sm' | 'md' | 'lg' | undefined;
  direction?: 'row' | 'column' | undefined;
  blur?: boolean | undefined;
  bluredDots?: BluredDotsProps | undefined;
}

const { variant = 'default', size = 'md', direction = 'column', blur = false, bluredDots, ...rest } = Astro.props;
---

<Element
  class:list={['card', { 'card-blur': blur, 'card-has-dots': bluredDots?.length }]}
  {variant}
  {size}
  {direction}
  {...rest}
>
  {bluredDots?.map((dot) => <BluredDot {...dot} />)}
  <slot />
</Element>
