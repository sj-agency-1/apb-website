---
import type { HTMLAttributes } from 'astro/types';
import Element from './Element.astro';

interface Props extends HTMLAttributes<'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6'> {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | undefined;
  depth?: 1 | 2 | 3 | 4 | 5 | 6 | number | undefined;
  text?: string | undefined;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | undefined;
}

const { depth = 2, as = `h${depth}`, text, ...rest } = Astro.props;
---

<Element class:list="heading" {as} {...rest}>
  <Fragment set:html={text} />
  <slot />
</Element>
