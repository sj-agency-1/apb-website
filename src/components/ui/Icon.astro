---
import tablerIcons from '@iconify-json/tabler/icons.json';
import type { HTMLAttributes } from 'astro/types';
import Element from './Element.astro';

interface TablerIcon {
  body: string;
  [key: string]: unknown;
}

interface TablerIconsJson {
  icons: Record<string, TablerIcon>;
  [key: string]: unknown;
}

interface Props extends HTMLAttributes<'svg'> {
  size?: 'sm' | 'md' | 'lg' | undefined;
  name?: string | undefined;
}

const { size = 'md', name, ...rest } = Astro.props;

const trimmedName = name?.trim();
const icon = trimmedName ? (tablerIcons as TablerIconsJson).icons[trimmedName]?.body : undefined;
---

<Element class:list="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" as="svg" {size} {...rest}>
  <Fragment set:html={icon} />
</Element>
