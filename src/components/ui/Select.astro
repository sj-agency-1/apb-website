---
import type { HTMLAttributes } from 'astro/types';
import Element from './Element.astro';
import Icon from './Icon.astro';
import Label from './Label.astro';

interface Props extends HTMLAttributes<'select'> {
  size?: 'sm' | 'md' | 'lg' | undefined;
  label?: string | undefined;
  placeholder?: string | undefined;
  options?: string[] | undefined;
  value?: string | undefined;
}

const {
  label,
  placeholder,
  name = label || placeholder,
  id = name,
  size = 'md',
  options,
  value,
  ...rest
} = Astro.props;
---

{
  options && (
    <Label class:list="select" for={id} {size}>
      <Fragment set:html={label} />
      <Element class:list="select-select" as="select" {id} {name} {...rest}>
        <Element class:list="select-option" as="option" value={placeholder} set:html={placeholder} disabled selected />
        {options?.map((option: string) => (
          <Element
            class:list="select-option"
            as="option"
            selected={value === option}
            set:html={option}
            value={option}
          />
        ))}
        <slot />
      </Element>
      <Icon name="chevron-down" />
    </Label>
  )
}

<style is:global>
  @layer ui {
    .select {
      @apply relative flex flex-col gap-1.5;

      .icon {
        @apply pointer-events-none absolute;
      }

      .select-select {
        @apply flex w-full appearance-none rounded-lg border border-border bg-background pr-10 text-sm;
        @apply file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground;
        @apply focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background;
        @apply disabled:pointer-events-none disabled:opacity-50;
        @apply [&[readonly]]:pointer-events-none;
      }

      &.size-sm {
        .select-select {
          @apply h-9 px-2.5 py-1.5 pr-9 text-xs;
        }

        .icon {
          @apply bottom-2 right-2;
        }
      }

      &.size-md {
        .select-select {
          @apply h-10 px-3 py-2 pr-10 text-sm;
        }

        .icon {
          @apply bottom-2.5 right-2.5;
        }
      }

      &.size-lg {
        .select-select {
          @apply h-12 px-3.5 py-2.5 pr-11 text-base;
        }

        .icon {
          @apply bottom-3.5 right-3.5;
        }
      }
    }
  }
</style>
