---
import type { HTMLAttributes } from 'astro/types';
import Button from './Button.astro';
import Element from './Element.astro';

interface Props extends HTMLAttributes<'div'> {
  title: string;
  url: string;
  shareLabel?: string;
  copyLinkLabel?: string;
  copiedLabel?: string;
}

const { title, url, shareLabel = 'Share', copyLinkLabel = 'Copy link', copiedLabel = 'Copied!', ...rest } = Astro.props;

// Encode for URL parameters
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedText = encodeURIComponent(`${title} ${url}`);

// Share URLs for each platform
const shareUrls = {
  x: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  vk: `https://vk.com/share.php?url=${encodedUrl}&title=${encodedTitle}`,
  ok: `https://connect.ok.ru/offer?url=${encodedUrl}&title=${encodedTitle}`,
  telegram: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
  whatsapp: `https://wa.me/?text=${encodedText}`,
};
---

<Element class:list={['share-buttons']} {...rest}>
  <span class="share-label text-sm text-muted-foreground font-medium">{shareLabel}:</span>

  <!-- Toast Notification -->
  <div class="copy-toast" role="alert" aria-live="polite">
    {copiedLabel}
  </div>

  <div class="share-icons flex flex-wrap items-center gap-2">
    <!-- Copy Link Button -->
    <Button
      variant="ghost"
      size="sm"
      icon="link"
      class="share-btn copy-link-btn"
      data-url={url}
      data-copy-label={copyLinkLabel}
      data-copied-label={copiedLabel}
      title={copyLinkLabel}
      aria-label={copyLinkLabel}
    />

    <!-- X (Twitter) -->
    <Button
      variant="ghost"
      size="sm"
      icon="brand-x"
      href={shareUrls.x}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      title="X (Twitter)"
      aria-label="Share on X (Twitter)"
    />

    <!-- Facebook -->
    <Button
      variant="ghost"
      size="sm"
      icon="brand-facebook"
      href={shareUrls.facebook}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      title="Facebook"
      aria-label="Share on Facebook"
    />

    <!-- VK -->
    <Button
      variant="ghost"
      size="sm"
      icon="brand-vk"
      href={shareUrls.vk}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      title="VKontakte"
      aria-label="Share on VKontakte"
    />

    <!-- OK.ru -->
    <Button
      variant="ghost"
      size="sm"
      icon="brand-ok-ru"
      href={shareUrls.ok}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      title="Odnoklassniki"
      aria-label="Share on Odnoklassniki"
    />

    <!-- Telegram -->
    <Button
      variant="ghost"
      size="sm"
      icon="brand-telegram"
      href={shareUrls.telegram}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      title="Telegram"
      aria-label="Share on Telegram"
    />

    <!-- WhatsApp -->
    <Button
      variant="ghost"
      size="sm"
      icon="brand-whatsapp"
      href={shareUrls.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      title="WhatsApp"
      aria-label="Share on WhatsApp"
    />
  </div>
</Element>

<style>
  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.5rem;
    margin-top: 1.5rem;
    border-top: 1px solid hsl(var(--border) / 0.3);
  }

  .share-btn {
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .share-btn:hover {
    transform: scale(1.1);
  }

  .copy-link-btn.copied {
    color: hsl(var(--success, 142 76% 36%));
  }

  .copy-toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: hsl(var(--success, 142 76% 36%));
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
    z-index: 9999;
  }

  .copy-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const copyButtons = document.querySelectorAll('.copy-link-btn');

    copyButtons.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();

        const button = e.currentTarget as HTMLElement;
        const urlData = button.dataset.url;
        const copiedLabel = button.dataset.copiedLabel || 'Copied!';

        if (!urlData) return;

        // Get the full URL (handle both full URLs and relative paths)
        let fullUrl = urlData;
        if (!urlData.startsWith('http')) {
          // If it's a relative path, construct the full URL
          fullUrl = window.location.origin + (urlData.startsWith('/') ? urlData : '/' + urlData);
        } else {
          // If it's already a full URL, use it as is
          fullUrl = urlData;
        }

        try {
          await navigator.clipboard.writeText(fullUrl);

          // Visual feedback on button
          button.classList.add('copied');
          button.setAttribute('title', copiedLabel);

          // Show toast notification
          const shareButtons = button.closest('.share-buttons');
          const toast = shareButtons?.querySelector('.copy-toast');
          if (toast) {
            toast.classList.add('show');

            // Hide toast after 2 seconds
            setTimeout(() => {
              toast.classList.remove('show');
            }, 2000);
          }

          // Reset button after 2 seconds
          setTimeout(() => {
            button.classList.remove('copied');
            button.setAttribute('title', button.dataset.copyLabel || 'Copy link');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy URL:', err);
        }
      });
    });
  });
</script>
