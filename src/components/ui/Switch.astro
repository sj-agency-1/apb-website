---
import type { ComponentProps, HTMLAttributes } from 'astro/types';
import Element from './Element.astro';
import Label from './Label.astro';

interface Props extends Omit<HTMLAttributes<'input'>, 'type'> {
  label?: ComponentProps<typeof Label>['text'];
  size?: 'sm' | 'md' | 'lg';
}

const { label, name = label, id = name, size = 'md', ...rest } = Astro.props;
---

<Label class:list="switch" for={id} {size}>
  <Element class:list="switch-input" as="input" type="checkbox" show={id} {id} {name} {...rest} />
  <Element as="label" for={id} show={id} class="switch-mark" />
  <Fragment set:html={label} />
</Label>
