---
import type { HTMLAttributes } from 'astro/types';
import Element from './Element.astro';
import Label from './Label.astro';

interface Props extends HTMLAttributes<'textarea'> {
  size?: 'sm' | 'md' | 'lg' | undefined;
  label?: string | undefined;
}

const { label, placeholder, name = label || placeholder, id = name, size = 'md', rows = 3, ...rest } = Astro.props;
---

<Label class:list="textarea" for={id} {size}>
  <Fragment set:html={label} />
  <Element class:list="textarea-textarea" as="textarea" show={id} {id} {name} {placeholder} {rows} {...rest} />
</Label>
