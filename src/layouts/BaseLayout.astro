---
import Layout from '@components/structures/Layout.astro';
import type { ComponentProps, HTMLAttributes } from 'astro/types';
import Header from '@components/blocks/Header.astro';
import Footer from '@components/blocks/Footer.astro';
import PreFooter from '@components/blocks/PreFooter.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { getHeaderData, getFooterData, getPreFooterData } from '@data/navigation';
import type { SupportedLanguage } from '@/types/i18n';
import Head from '@components/ui/Head.astro';

type HeadProps = ComponentProps<typeof Head>;

type Props = Omit<HTMLAttributes<'body'>, 'title'> & {
  head: HeadProps;
  showHeader?: boolean;
  showFooter?: boolean;
  showPreFooter?: boolean;
};

const { head, showHeader = true, showFooter = true, showPreFooter = true, ...rest } = Astro.props;

const lang = getLangFromUrl(Astro.url) as SupportedLanguage;
const t = useTranslations(lang);

const headerData = getHeaderData(lang, t);
const footerData = getFooterData(lang, t);
const preFooterData = getPreFooterData(t);
---

<Layout head={head} {...rest}>
  {showHeader && <Header {...headerData} />}
  <main>
    <slot />
  </main>
  {showPreFooter && <PreFooter {...preFooterData} />}
  {showFooter && <Footer {...footerData} />}
</Layout>
