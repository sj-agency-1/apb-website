---
import BaseLayout from './BaseLayout.astro';
import Hero from '@components/blocks/Hero.astro';
import type { ComponentProps, HTMLAttributes } from 'astro/types';
import Head from '@components/ui/Head.astro';

type HeadProps = ComponentProps<typeof Head>;

interface HeroProps {
  tagline?: string;
  title: string;
}

type Props = Omit<HTMLAttributes<'body'>, 'title'> & {
  head: HeadProps;
  hero?: HeroProps;
};

const { head, hero, ...rest } = Astro.props;
---

<BaseLayout {head} {...rest}>
  {
    hero && (
      <Hero layout="page" backgroundImage="/assets/images/bg-1.webp">
        <div class="flex flex-col gap-2">
          {hero.tagline && (
            <div class="text-sm text-muted-foreground uppercase tracking-wider font-medium">{hero.tagline}</div>
          )}
          <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight">{hero.title}</h1>
        </div>
      </Hero>
    )
  }
  <slot />
</BaseLayout>
