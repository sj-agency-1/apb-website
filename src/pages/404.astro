---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/blocks/Section.astro';
import Button from '@components/ui/Button.astro';
---

<BaseLayout
  head={{
    title: '404: Page Not Found',
    description: 'The page you are looking for does not exist.',
  }}
>
  <Section class="flex flex-col items-center justify-center text-center py-20">
    <h1 class="text-9xl font-bold text-primary">404</h1>
    <h2 class="text-3xl font-semibold text-heading mt-4 mb-2">Page Not Found</h2>
    <p class="text-lg text-foreground/80 mb-8">Sorry, we couldn't find the page you're looking for.</p>
    <Button href="/" text="Go to Homepage" variant="primary" size="lg" />
  </Section>
</BaseLayout>
