---
import PageLayout from '@layouts/PageLayout.astro';
import Section from '@components/blocks/Section.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import Card from '@components/ui/Card.astro';
import AdvantagesCarousel from '@components/structures/AdvantagesCarousel.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getPageContent } from '@data/pages';
import { getAboutContent } from '@data/about-content';
import { SUPPORTED_LANGUAGES, type SupportedLanguage } from '@/types/i18n';

import aboutHero from '@assets/images/pages/about-2.webp';
import about1 from '@assets/images/pages/about-1.webp';
import about2 from '@assets/images/pages/about-2.webp';
import about3 from '@assets/images/pages/about-3.webp';

import aboutIconAudit from '@assets/images/pages/about-icon-audit.webp';
import aboutIconDevelop from '@assets/images/pages/about-icon-develop.webp';
import aboutIconFinances from '@assets/images/pages/about-icon-finances.webp';
import aboutIconLaunch from '@assets/images/pages/about-icon-launch.webp';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const page = getPageContent('about', lang);
const content = getAboutContent(lang);

// Get latest advantages posts
const allAdvantages = await getCollection('advantages', (entry) => {
  const [entryLang] = entry.id.split('/');
  return entryLang === lang && !entry.data.isArchive;
});
const advantagesPosts = allAdvantages.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

// Icon paths for service cards
const cardIcons = {
  audit: aboutIconAudit,
  products: aboutIconDevelop,
  financial: aboutIconFinances,
  launch: aboutIconLaunch,
};
---

<PageLayout head={page.meta} hero={page.hero}>
  <Section id="about" variant="default">
    <div class="relative mb-12">
      <Image
        src={about1}
        alt={content.heroAlt}
        width={1200}
        height={600}
        class="w-full rounded-2xl max-h-119.75 object-cover"
      />
    </div>

    <Breadcrumbs items={[{ text: content.breadcrumb }]} class="mb-6" />

    <div class="mb-12">
      <h2 class="text-3xl lg:text-4xl font-bold text-heading mb-6">{content.mainTitle}</h2>
      <div class="flex flex-col gap-6">
        <h3 class="text-xl lg:text-2xl font-semibold text-heading">
          {content.welcomeTitle}
        </h3>
        <p class="text-lg text-foreground leading-relaxed">
          {content.welcomeIntro}
        </p>
        <p class="text-foreground leading-relaxed">
          {content.welcomeDescription}
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[2fr_3fr] gap-8 mb-12">
      <div class="flex flex-col gap-4">
        <Image src={about1} alt={content.aboutServiceAlt} width={600} height={400} class="rounded-2xl" />
      </div>
      <div class="flex flex-col gap-4 justify-center">
        <h3 class="text-2xl lg:text-3xl font-bold text-heading">
          {content.secretTitle}
        </h3>
        <p class="text-foreground leading-relaxed">
          {content.secretParagraph1}
        </p>
        <p class="text-foreground leading-relaxed">
          {content.secretParagraph2}
        </p>
      </div>
    </div>

    <div class="mb-12">
      <Image
        src={about3}
        alt={content.heroAlt}
        width={1200}
        height={360}
        class="w-full rounded-2xl max-h-87.25 object-cover"
      />
    </div>

    <div class="mb-12">
      <h3 class="text-2xl lg:text-3xl font-bold text-heading mb-6">{content.serviceTitle}</h3>
      <p class="text-foreground leading-relaxed mb-8">
        {content.serviceIntro}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          content.serviceCards.map((card) => (
            <Card variant="default" size="lg">
              <div class="flex flex-col gap-4 p-4">
                <div>
                  <Image src={cardIcons[card.icon]} alt={card.title} width={100} height={100} />
                </div>
                <h4 class="text-lg font-semibold text-heading">{card.title}</h4>
                <p class="text-muted-foreground leading-relaxed">{card.description}</p>
              </div>
            </Card>
          ))
        }
      </div>

      <p class="text-foreground leading-relaxed mt-8">
        {content.serviceOutro}
      </p>
    </div>

    <div class="mb-12">
      <Card variant="default" size="lg">
        <div class="flex flex-col gap-4 p-4">
          <h2 class="text-2xl lg:text-3xl font-bold text-heading">
            {content.noExperienceTitle}
          </h2>
          <p>
            {content.noExperienceParagraph1}
          </p>
          <p>
            {content.noExperienceParagraph2}
          </p>

          <Card
            variant="default"
            size="lg"
            bluredDots={[
              {
                color: 'FFAB24',
                top: 0,
                left: 0,
                width: 0,
                height: 0,
                shadowBlur: 1000,
                shadowSpread: 300,
                opacity: 0.1,
              },
              {
                color: 'FFAB24',
                top: 0,
                right: 0,
                width: 0,
                height: 0,
                shadowBlur: 1000,
                shadowSpread: 300,
                opacity: 0.1,
              },
              {
                color: 'FFAB24',
                top: 0,
                right: 600,
                width: 0,
                height: 0,
                shadowBlur: 1000,
                shadowSpread: 100,
                opacity: 0.1,
              },
            ]}
          >
            <div>
              <span class="text-primary">{content.noExperienceImportantLabel}</span>
              {content.noExperienceImportant}
            </div>
          </Card>

          <p>
            {content.noExperienceParagraph3}<b>{content.noExperienceParagraph3Bold}</b>
          </p>
        </div>
      </Card>
    </div>

    <div class="relative mb-12">
      <Image
        src={aboutHero}
        alt={content.heroAlt}
        width={1200}
        height={600}
        class="w-full rounded-2xl max-h-119.75 object-cover"
      />
    </div>

    <!-- Reliability Guarantee Section -->
    <div class="mb-12">
      <h3 class="text-2xl lg:text-3xl font-bold text-heading mb-6">{content.reliabilityTitle}</h3>
      <p class="text-foreground leading-relaxed mb-4">
        {content.reliabilityParagraph1}
      </p>
      <p class="text-foreground leading-relaxed mb-4">
        {content.reliabilityParagraph2}
      </p>
      <p class="text-foreground leading-relaxed">
        {content.reliabilityParagraph3}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[2fr_3fr] gap-8 mb-12">
      <div>
        <Image src={about2} alt={content.yourBrandAlt} width={600} height={400} class="rounded-2xl" />
      </div>
      <div class="flex flex-col gap-4 justify-center">
        <h3 class="text-2xl lg:text-3xl font-bold text-heading">{content.brandTitle}</h3>
        <p class="text-foreground leading-relaxed">
          {content.brandParagraph1}
        </p>
        <p class="text-foreground leading-relaxed">
          {content.brandParagraph2}
        </p>
        <ul class="list-disc list-inside text-foreground space-y-2 ml-4">
          {content.brandListItems.map((item) => <li>{item}</li>)}
        </ul>
        <p class="text-foreground leading-relaxed">
          {content.brandParagraph3}
        </p>
      </div>
    </div>

    <div class="mb-12 bg-secondary/30 rounded-2xl p-8">
      <h3 class="text-2xl lg:text-3xl font-bold text-heading mb-6">{content.scoutTitle}</h3>
      <p class="text-foreground leading-relaxed mb-4">
        {content.scoutParagraph1}
      </p>
      <p class="text-foreground leading-relaxed mb-4">
        {content.scoutParagraph2}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[2fr_3fr] gap-8 mb-12">
      <div>
        <Image src={about3} alt={content.contentAlt} width={600} height={400} class="rounded-2xl" />
      </div>
      <div class="flex flex-col gap-4 justify-center">
        <h3 class="text-2xl lg:text-3xl font-bold text-heading">{content.contentTitle}</h3>
        <p class="text-foreground leading-relaxed">
          {content.contentParagraph1}
        </p>
        <p class="text-foreground leading-relaxed">
          {content.contentParagraph2}
        </p>
        <p class="text-foreground leading-relaxed">
          {content.contentParagraph3}
        </p>
        <p class="text-foreground italic mt-4" set:html={content.contentSignature} />
      </div>
    </div>
  </Section>

  <Section id="advantages-articles" variant="dark">
    <AdvantagesCarousel
      posts={advantagesPosts}
      title={content.advantagesSectionTitle}
      subtitle={content.advantagesSectionSubtitle}
      lang={lang}
      readMoreText={content.readMoreButton}
      seeAllText={content.seeAllButton}
      seeAllHref={`/${lang}/advantages`}
    />
  </Section>
</PageLayout>
