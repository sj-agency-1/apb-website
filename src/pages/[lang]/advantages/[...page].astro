---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/blocks/Hero.astro';
import Section from '@components/blocks/Section.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import PostsGridStyles from '@components/structures/PostsGridStyles.astro';
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import Image from '@components/ui/Image.astro';
import Heading from '@components/ui/Heading.astro';
import Paragraph from '@components/ui/Paragraph.astro';
import { useTranslations } from '@i18n/utils';
import { LANGUAGES } from '@consts';

export async function getStaticPaths({ paginate }) {
  const paths = [];

  for (const lang of LANGUAGES) {
    const allPosts = await getCollection('advantages', (entry) => {
      const [entryLang] = entry.id.split('/');
      return entryLang === lang && !entry.data.isArchive;
    });

    const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
    const allTags = [...new Set(sortedPosts.flatMap((post) => post.data.tags))];

    const pages = paginate(sortedPosts, {
      params: { lang },
      pageSize: 9,
      props: { allTags },
    });

    paths.push(...pages);
  }

  return paths;
}

const { lang } = Astro.params;
const { page, allTags } = Astro.props;
const t = useTranslations(lang as 'en' | 'ru');

const paginatedPosts = page.data;
const selectedTag = null;

// Pagination settings
const totalPages = page.lastPage;
const currentPage = page.currentPage;
const showPagination = totalPages > 1;
const showTagsAndSearch = true;

// Generate page numbers for pagination
const pageNumbers: (number | string)[] = [];
if (totalPages <= 7) {
  for (let i = 1; i <= totalPages; i++) pageNumbers.push(i);
} else {
  if (currentPage <= 3) {
    pageNumbers.push(1, 2, 3, '...', totalPages);
  } else if (currentPage >= totalPages - 2) {
    pageNumbers.push(1, '...', totalPages - 2, totalPages - 1, totalPages);
  } else {
    pageNumbers.push(1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages);
  }
}

// Helper to build URL
function buildUrl(pageNum: number, tag?: string | null) {
  const base = `/${lang}/advantages`;
  if (tag) {
    return pageNum > 1 ? `${base}/tag/${tag}/${pageNum}` : `${base}/tag/${tag}`;
  }
  return pageNum > 1 ? `${base}/${pageNum}` : `${base}`;
}

// Get slug from entry id
function getSlug(id: string) {
  const parts = id.split('/');
  parts.shift(); // Remove language prefix
  return parts.join('/').replace(/\.mdx?$/, '');
}
---

<PageLayout
  head={{
    title: t('advantagesPage.hero.title'),
    description: t('advantagesPage.hero.pretitle'),
  }}
>
  <PostsGridStyles />
  <!-- Hero Section -->
  <Hero layout="page" backgroundImage="/src/assets/images/bg-1.webp">
    <div class="flex flex-col gap-2">
      <div class="text-sm text-muted-foreground uppercase tracking-wider font-medium">
        {t('advantagesPage.hero.pretitle')}
      </div>
      <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight">
        {t('advantagesPage.hero.title')}
      </h1>
    </div>
  </Hero>

  <!-- Content Section -->
  <Section id="advantages-list" variant="default">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={[{ text: t('advantagesPage.hero.title') }]} class="mb-6" />

    <!-- Tags Filter -->
    {
      showTagsAndSearch && allTags.length > 0 && (
        <div class="tags-filter mb-8">
          <a href={buildUrl(1, null)} class:list={['tag-button', { active: !selectedTag }]}>
            {t('advantagesPage.allTags')}
          </a>
          {allTags.map((tag) => (
            <a href={buildUrl(1, tag)} class:list={['tag-button', { active: selectedTag === tag }]}>
              {tag}
            </a>
          ))}
        </div>
      )
    }

    <!-- Posts Grid -->
    <div class="posts-grid">
      {
        paginatedPosts.map((post) => {
          const slug = getSlug(post.id);
          const excerptTitle = post.data.excerptTitle || post.data.title;
          return (
            <Card variant="default" size="sm" class="post-card">
              <a href={`/${lang}/advantages/${slug}`} class="post-image">
                <Image src={post.data.heroImage} alt={excerptTitle} width={400} height={250} />
              </a>
              <div class="post-content">
                <Heading as="h3" size="lg" text={excerptTitle} class="post-title" />
                <Paragraph text={post.data.excerptDescription} muted class="post-excerpt" />
                <Button
                  text={t('advantagesPage.readMore')}
                  href={`/${lang}/advantages/${slug}`}
                  variant="outline"
                  size="sm"
                  class="post-cta"
                />
              </div>
            </Card>
          );
        })
      }
    </div>

    <!-- Pagination -->
    {
      showPagination && (
        <nav class="pagination" aria-label="Pagination">
          <a
            href={page.url.prev || undefined}
            class:list={['pagination-btn', { disabled: !page.url.prev }]}
            aria-disabled={!page.url.prev}
          >
            <span class="sr-only">{t('blog.pagination.prev')}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m15 18-6-6 6-6" />
            </svg>
          </a>

          {pageNumbers.map((num) =>
            typeof num === 'number' ? (
              <a
                href={buildUrl(num, selectedTag)}
                class:list={['pagination-num', { active: num === currentPage }]}
                aria-current={num === currentPage ? 'page' : undefined}
              >
                {num}
              </a>
            ) : (
              <span class="pagination-ellipsis">{num}</span>
            )
          )}

          <a
            href={page.url.next || undefined}
            class:list={['pagination-btn', { disabled: !page.url.next }]}
            aria-disabled={!page.url.next}
          >
            <span class="sr-only">{t('blog.pagination.next')}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </a>
        </nav>
      )
    }
  </Section>
</PageLayout>
