---
import { getCollection, render } from 'astro:content';
import PostLayout from '@layouts/PostLayout.astro';
import Section from '@components/blocks/Section.astro';
import Sidebar from '@components/blocks/Sidebar.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import Card from '@components/ui/Card.astro';
import ShareButtons from '@components/ui/ShareButtons.astro';
import { useTranslations } from '@i18n/utils';
import { getLatestAdvantagesPosts } from '@utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('advantages');

  const paths = posts.map((post) => {
    const [lang, ...slugParts] = post.id.split('/');
    const filenameSlug = slugParts.join('/').replace(/\.mdx?$/, '');
    // Use custom slug from frontmatter if provided, otherwise use filename
    const slug = post.data.slug || filenameSlug;
    return {
      params: { lang, slug: slug || undefined },
      props: { post },
    };
  });

  return paths;
}

const { lang } = Astro.params;
const { post } = Astro.props;
const t = useTranslations(lang as 'en' | 'ru');

const { Content, headings } = await render(post);

// Generate TOC items from headings
const tocItems = headings
  .filter((h) => h.depth <= 3)
  .map((h) => ({
    id: h.slug,
    chapter: '',
    text: h.text,
  }));

// Get latest advantages posts for sidebar
const blogItems = await getLatestAdvantagesPosts(lang as 'en' | 'ru', 2);
---

<PostLayout
  head={{
    title: post.data.title,
    description: post.data.description || post.data.excerptDescription,
  }}
  hero={{
    tagline: t('advantages.hero.pretitle'),
    title: t('advantages.hero.title'),
  }}
>
  <!-- Content Section -->
  <Section id="post-content" variant="default">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-8 lg:gap-12">
      <!-- Sidebar -->
      <Sidebar
        tocItems={tocItems}
        blogItems={blogItems}
        blogTitle={t('sidebar.blogTitle')}
        ctaText={t('advantages.readMore')}
      />

      <!-- Main Content -->
      <div class="post-main">
        <!-- Breadcrumbs -->
        <Breadcrumbs
          items={[
            { text: t('advantages.hero.title'), href: `/${lang}/advantages` },
            { text: post.data.breadcrumbsTitle || post.data.title },
          ]}
          class="mb-6"
        />

        <!-- Post Content -->
        <Card variant="default" blur={true} class="post-content px-0!">
          <article class="prose prose-invert max-w-none">
            <Content />
          </article>

          <!-- Share Buttons -->
          <ShareButtons
            title={post.data.title}
            url={Astro.url.href}
            shareLabel={t('share.label')}
            copyLinkLabel={t('share.copyLink')}
            copiedLabel={t('share.copied')}
          />
        </Card>
      </div>
    </div>
  </Section>
</PostLayout>
