---
import { getCollection, render } from 'astro:content';
import PostLayout from '@layouts/PostLayout.astro';
import Hero from '@components/blocks/Hero.astro';
import Section from '@components/blocks/Section.astro';
import Sidebar from '@components/blocks/Sidebar.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import Card from '@components/ui/Card.astro';
import { useTranslations } from '@i18n/utils';
import { getLatestBlogPosts } from '@utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('advantages');

  const paths = posts.map((post) => {
    const [lang, ...slugParts] = post.id.split('/');
    const slug = slugParts.join('/').replace(/\.mdx?$/, '');
    return {
      params: { lang, slug: slug || undefined },
      props: { post },
    };
  });

  return paths;
}

const { lang } = Astro.params;
const { post } = Astro.props;
const t = useTranslations(lang as 'en' | 'ru');

const { Content, headings } = await render(post);

// Generate TOC items from headings
const tocItems = headings
  .filter((h) => h.depth <= 3)
  .map((h) => ({
    id: h.slug,
    chapter: '',
    text: h.text,
  }));

// Get latest blog posts for sidebar
const blogItems = await getLatestBlogPosts(lang as 'en' | 'ru', 2);
---

<PostLayout
  head={{
    title: post.data.title,
    description: post.data.description || post.data.excerptDescription,
  }}
>
  <!-- Hero Section -->
  <Hero layout="page" backgroundImage="/src/assets/images/bg-1.webp">
    <div class="flex flex-col gap-2">
      <div class="text-sm text-muted-foreground uppercase tracking-wider font-medium">
        {t('advantagesPage.hero.pretitle')}
      </div>
      <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight">
        {t('advantagesPage.hero.title')}
      </h1>
    </div>
  </Hero>

  <!-- Content Section -->
  <Section id="post-content" variant="default">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-8 lg:gap-12">
      <!-- Sidebar -->
      <Sidebar
        tocItems={tocItems}
        blogItems={blogItems}
        blogTitle={t('sidebar.blogTitle')}
        ctaText={t('advantagesPage.readMore')}
        sectionId="post-content"
      />

      <!-- Main Content -->
      <div class="post-main">
        <!-- Breadcrumbs -->
        <Breadcrumbs
          items={[{ text: t('advantagesPage.hero.title'), href: `/${lang}/advantages` }, { text: post.data.title }]}
          class="mb-6"
        />

        <!-- Post Content -->
        <Card variant="default" size="lg" class="post-content">
          <article class="prose prose-invert max-w-none">
            <Content />
          </article>
        </Card>
      </div>
    </div>
  </Section>
</PostLayout>

<style>
  .post-main {
    @apply flex flex-col;
  }

  .post-content {
    @apply bg-card;
  }

  .post-content :global(.prose) {
    @apply text-foreground;
  }

  .post-content :global(.prose h1),
  .post-content :global(.prose h2),
  .post-content :global(.prose h3),
  .post-content :global(.prose h4) {
    @apply text-heading font-heading;
  }

  .post-content :global(.prose a) {
    @apply text-primary hover:text-primary-hover;
  }

  .post-content :global(.prose p) {
    @apply text-foreground leading-relaxed;
  }

  .post-content :global(.prose ul),
  .post-content :global(.prose ol) {
    @apply text-foreground;
  }

  .post-content :global(.prose blockquote) {
    @apply border-l-primary text-muted-foreground;
  }
</style>
