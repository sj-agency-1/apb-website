---
import PageLayout from '@layouts/PageLayout.astro';
import Section from '@components/blocks/Section.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import { Image } from 'astro:assets';
import { contacts } from '@data/contacts';
import { getPageContent } from '@data/pages';
import { getContactsContent } from '@data/page-content';
import { SUPPORTED_LANGUAGES, type SupportedLanguage } from '@/types/i18n';

import telegramIcon from '@assets/images/socials/tg.webp';
import whatsappIcon from '@assets/images/socials/whatsapp.webp';
import gmailIcon from '@assets/images/socials/gmail.webp';
import helpIcon from '@assets/images/help.webp';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const page = getPageContent('contacts', lang);
const content = getContactsContent(lang);
---

<PageLayout head={page.meta} hero={page.hero}>
  <Section id="contacts" variant="default">
    <Breadcrumbs items={[{ text: content.breadcrumb }]} class="mb-6" />

    <div class="mb-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-heading mb-4">{content.heading}</h2>
      <p class="text-foreground leading-relaxed">
        {content.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Telegram Card -->
      <Card variant="default" size="lg" class="text-center">
        <a
          href={contacts.telegramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center gap-4 p-8 h-full hover:opacity-80 transition-opacity"
        >
          <Image src={telegramIcon} alt="Telegram" width={120} height={120} class="w-28 h-28 object-contain" />
          <span class="text-xl font-semibold text-heading">{contacts.telegram}</span>
        </a>
      </Card>

      <!-- WhatsApp Card -->
      <Card variant="default" size="lg" class="text-center">
        <a
          href={contacts.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center gap-4 p-8 h-full hover:opacity-80 transition-opacity"
        >
          <Image src={whatsappIcon} alt="WhatsApp" width={120} height={120} class="w-28 h-28 object-contain" />
          <span class="text-xl font-semibold text-heading">{contacts.whatsapp}</span>
        </a>
      </Card>

      <!-- Email Card -->
      <Card variant="default" size="lg" class="text-center">
        <a
          href={contacts.emailUrl}
          class="flex flex-col items-center gap-4 p-8 h-full hover:opacity-80 transition-opacity"
        >
          <Image src={gmailIcon} alt="Email" width={120} height={120} class="w-28 h-28 object-contain" />
          <span class="text-xl font-semibold text-heading">{contacts.email}</span>
        </a>
      </Card>

      <!-- Help/Support Card -->
      <Card variant="default" size="lg" class="text-center">
        <div class="flex flex-col items-center gap-4 p-8 h-full">
          <Image src={helpIcon} alt={content.helpCardTitle} width={120} height={120} class="w-28 h-28 object-contain" />
          <h3 class="text-xl font-semibold text-heading">{content.helpCardTitle}</h3>
          <p class="text-muted-foreground text-sm leading-relaxed">{content.helpCardDescription}</p>
          <Button
            text={content.helpCardButton}
            href={contacts.telegramUrl}
            variant="primary"
            size="lg"
            target="_blank"
          />
        </div>
      </Card>
    </div>
  </Section>
</PageLayout>
