---
import PageLayout from '@layouts/PageLayout.astro';
import Section from '@components/blocks/Section.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import StepsAccordion from '@components/structures/StepsAccordion.astro';
import { getStepPricing } from '@data/pricing';
import { getPageContent } from '@data/pages';
import { getHowItWorksContent } from '@data/page-content';
import { SUPPORTED_LANGUAGES, type SupportedLanguage } from '@/types/i18n';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const page = getPageContent('howItWorks', lang);
const content = getHowItWorksContent(lang);
const steps = getStepPricing(lang);
---

<PageLayout head={page.meta} hero={page.hero}>
  <Section id="how-it-works" variant="default">
    <Breadcrumbs items={[{ text: content.breadcrumb }]} class="mb-6" />

    <div class="mb-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-heading mb-4">
        {content.heading}
      </h2>
      <p class="text-foreground leading-relaxed">
        {content.description}
      </p>
    </div>

    <div class="mb-6">
      <h3 class="text-lg font-semibold text-heading mb-2">{content.stepsIntro}</h3>
    </div>

    <StepsAccordion
      items={steps}
      stepLabel={content.stepLabel}
      descriptionLabel={content.descriptionLabel}
      purposeLabel={content.purposeLabel}
      faqLabel={content.faqLabel}
      priceLabel={content.priceLabel}
      promoPriceLabel={content.promoPriceLabel}
    />
  </Section>
</PageLayout>
