---
import PageLayout from '@layouts/PageLayout.astro';
import Section from '@components/blocks/Section.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import Modal from '@components/structures/Modal.astro';
import { Image } from 'astro:assets';
import { getReviews } from '@data/reviews';
import { getPageContent } from '@data/pages';
import { getReviewsContent } from '@data/page-content';
import { SUPPORTED_LANGUAGES, type SupportedLanguage } from '@/types/i18n';

import shareExperienceIcon from '@assets/images/share-experience.webp';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const page = getPageContent('reviews', lang);
const content = getReviewsContent(lang);
const reviews = getReviews(lang);
const REVIEWS_PER_PAGE = 8; // 4 + 4 reviews per page (plus 1 card in between)
---

<PageLayout head={page.meta} hero={page.hero}>
  <Section id="reviews" variant="default">
    <Breadcrumbs items={[{ text: content.breadcrumb }]} class="mb-6" />

    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl lg:text-3xl font-bold text-heading mb-2">{content.heading}</h2>
        <p class="text-foreground">
          {content.description}
        </p>
      </div>
    </div>

    <div id="reviews-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        reviews.map((review, index) => {
          const pageNumber = Math.floor(index / REVIEWS_PER_PAGE);
          const isFirstPage = pageNumber === 0;

          // Calculate if the current page is full (has 8 reviews)
          const startOfPage = pageNumber * REVIEWS_PER_PAGE;
          const endOfPage = Math.min(startOfPage + REVIEWS_PER_PAGE, reviews.length);
          const itemsOnThisPage = endOfPage - startOfPage;
          const isPageFull = itemsOnThisPage === REVIEWS_PER_PAGE;

          // Show share experience card as the 5th element (index 4 in the page) only if the page is full
          const positionInPage = index % REVIEWS_PER_PAGE;
          const showShareCard = isPageFull && positionInPage === 4;

          return (
            <>
              {showShareCard && (
                <Card
                  variant="default"
                  size="lg"
                  class="share-experience-card flex flex-col items-center justify-center text-center h-full w-full"
                  style={!isFirstPage ? 'display: none;' : ''}
                  data-page={pageNumber}
                >
                  <div class="flex flex-col items-center gap-4">
                    <Image
                      src={shareExperienceIcon}
                      alt={content.shareExperienceTitle}
                      width={120}
                      height={120}
                      class="w-24 h-24 object-contain"
                    />
                    <h3 class="text-xl font-semibold text-heading">{content.shareExperienceTitle}</h3>
                    <p class="text-muted-foreground leading-relaxed">{content.shareExperienceDescription}</p>
                    <Button
                      text={content.shareExperienceButton}
                      variant="primary"
                      size="lg"
                      class="leave-review-btn mt-2"
                    />
                  </div>
                </Card>
              )}
              <Card
                variant="default"
                size="lg"
                class="review-card flex flex-col h-full w-auto!"
                style={!isFirstPage ? 'display: none;' : ''}
                data-index={index}
                data-page={pageNumber}
              >
                <div class="flex items-start gap-4 mb-4">
                  <img
                    src={review.avatar}
                    alt={review.name}
                    width={64}
                    height={64}
                    class="w-16 h-16 rounded-full object-cover"
                  />
                  <div class="flex-1">
                    <h3 class="font-semibold text-heading">{review.name}</h3>
                    <p class="text-sm text-muted-foreground">
                      {review.age} {content.ageYears}, {review.location}
                    </p>
                  </div>
                </div>
                <div class="review-content relative flex-1">
                  <p class="text-foreground leading-relaxed line-clamp-6" id={`review-text-${index}`}>
                    {review.text}
                  </p>
                  <button
                    class="text-accent-blue text-sm font-medium mt-2 hover:underline focus:outline-none toggle-review-btn items-center gap-1 hidden"
                    data-target={`review-text-${index}`}
                    data-text-more={content.showMore}
                    data-text-less={content.showLess}
                  >
                    {content.showMore}
                    <Icon name="chevron-down" class="w-4 h-4 inline align-middle" />
                  </button>
                </div>
              </Card>
            </>
          );
        })
      }
    </div>

    <nav id="pagination" class="pagination mt-8 flex justify-center gap-2" aria-label="Pagination">
      {/* Pagination will be rendered by JS */}
    </nav>
  </Section>

  <Modal id="leave-review-modal" title={content.modalTitle} size="lg">
    <div class="flex flex-col md:flex-row items-center gap-8">
      <div class="shrink-0">
        <Image
          src={shareExperienceIcon}
          alt={content.modalHeading}
          width={128}
          height={128}
          class="w-32 h-32 object-contain"
        />
      </div>
      <div class="flex-1 text-center md:text-left">
        <h3 class="text-2xl font-bold text-heading mb-2">{content.modalHeading}</h3>
        <p class="text-foreground/80 mb-6">
          {content.modalDescription}
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
          <Button text={content.loginButton} href={`/${lang}/login`} variant="primary" size="lg" />
          <Button text={content.registerButton} href={`/${lang}/register`} variant="outline" size="lg" />
        </div>
      </div>
    </div>
  </Modal>
</PageLayout>

<script>
  function initReviews() {
    const reviewCards = document.querySelectorAll<HTMLElement>('.review-card');
    const shareCards = document.querySelectorAll<HTMLElement>('.share-experience-card');
    const paginationContainer = document.getElementById('pagination');
    const leaveReviewBtns = document.querySelectorAll('.leave-review-btn');
    const toggleBtns = document.querySelectorAll<HTMLElement>('.toggle-review-btn');

    const itemsPerPage = 8;
    const totalPages = Math.ceil(reviewCards.length / itemsPerPage);
    let currentPage = 0;

    // Show More/Less Logic
    toggleBtns.forEach((btn) => {
      const targetId = btn.dataset.target;
      if (!targetId) return;
      const textEl = document.getElementById(targetId);
      if (!textEl) return;

      // Check if truncation is needed
      if (textEl.scrollHeight > textEl.clientHeight) {
        btn.classList.remove('hidden');
      }

      // Clone button to remove old event listeners if any (when re-initializing)
      const newBtn = btn.cloneNode(true) as HTMLElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', () => {
        const isExpanded = !textEl.classList.contains('line-clamp-6');
        if (isExpanded) {
          textEl.classList.add('line-clamp-6');
          newBtn.innerHTML = `${newBtn.dataset.textMore || 'Show more'} <svg class="w-4 h-4 inline align-middle" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>`;
        } else {
          textEl.classList.remove('line-clamp-6');
          newBtn.innerHTML = `${newBtn.dataset.textLess || 'Show less'} <svg class="w-4 h-4 inline align-middle" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>`;
        }
      });
    });

    // Pagination Logic
    function renderPagination() {
      if (!paginationContainer || totalPages <= 1) {
        if (paginationContainer) paginationContainer.innerHTML = '';
        return;
      }

      let html = '';

      // Prev Button
      const prevDisabled = currentPage === 0;
      html += `
        <button
          class="pagination-btn ${prevDisabled ? 'disabled' : ''}"
          ${prevDisabled ? 'disabled' : ''}
          data-action="prev"
          aria-label="Previous page"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
      `;

      // Page Numbers
      const pageNumbers = [];
      if (totalPages <= 7) {
        for (let i = 0; i < totalPages; i++) pageNumbers.push(i);
      } else {
        if (currentPage <= 2) {
          pageNumbers.push(0, 1, 2, '...', totalPages - 1);
        } else if (currentPage >= totalPages - 3) {
          pageNumbers.push(0, '...', totalPages - 3, totalPages - 2, totalPages - 1);
        } else {
          pageNumbers.push(0, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages - 1);
        }
      }

      pageNumbers.forEach((num) => {
        if (typeof num === 'number') {
          const isActive = num === currentPage;
          html += `
            <button
              class="pagination-num ${isActive ? 'active' : ''}"
              data-page="${num}"
              aria-current="${isActive ? 'page' : 'false'}"
            >
              ${num + 1}
            </button>
          `;
        } else {
          html += `<span class="pagination-ellipsis">${num}</span>`;
        }
      });

      // Next Button
      const nextDisabled = currentPage === totalPages - 1;
      html += `
        <button
          class="pagination-btn ${nextDisabled ? 'disabled' : ''}"
          ${nextDisabled ? 'disabled' : ''}
          data-action="next"
          aria-label="Next page"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      `;

      paginationContainer.innerHTML = html;

      // Add Event Listeners
      paginationContainer.querySelectorAll('button').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.dataset.action === 'prev') {
            if (currentPage > 0) showPage(currentPage - 1);
          } else if (btn.dataset.action === 'next') {
            if (currentPage < totalPages - 1) showPage(currentPage + 1);
          } else if (btn.dataset.page) {
            showPage(parseInt(btn.dataset.page));
          }
        });
      });
    }

    function showPage(page: number) {
      currentPage = page;

      reviewCards.forEach((card) => {
        const cardPage = parseInt(card.dataset.page || '0');
        if (cardPage === page) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });

      // Share card logic
      shareCards.forEach((card) => {
        const cardPage = parseInt(card.dataset.page || '0');
        if (cardPage === page) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });

      renderPagination();

      // Scroll to top of reviews if not initial load
      const reviewsSection = document.getElementById('reviews');
      if (reviewsSection) {
        const rect = reviewsSection.getBoundingClientRect();
        if (rect.top < 0) {
          reviewsSection.scrollIntoView({ behavior: 'smooth' });
        }
      }
    }

    // Initial Render
    renderPagination();

    // Leave review modal triggers
    leaveReviewBtns.forEach((btn) => {
      // Clone to remove old listeners
      const newBtn = btn.cloneNode(true) as HTMLElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (typeof window.openModal === 'function') {
          window.openModal('leave-review-modal');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initReviews);
  document.addEventListener('astro:page-load', initReviews);
</script>
