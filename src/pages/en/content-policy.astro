---
import PageLayout from '@layouts/PageLayout.astro';
import Section from '@components/blocks/Section.astro';
import Sidebar from '@components/blocks/Sidebar.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import Content from '@components/blocks/Content.astro';
import { getPageContent } from '@data/pages';
import { getLatestAdvantagesPosts } from '@utils/posts';
import { getLegalPageContent } from '@data/page-content';
import { SUPPORTED_LANGUAGES } from '@/types/i18n';
import type { TocItem } from '@components/structures/TableOfContents.astro';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const page = getPageContent('contentPolicy', 'en');
const content = getLegalPageContent('contentPolicy', 'en');

const chapters = [
  {
    id: 'preamble',
    chapter: '',
    title: 'PREAMBLE (PURPOSE OF THE DOCUMENT)',
    content: `
      <p>This document (Content Usage Policy) is a legally binding agreement regulating the access rights, usage boundaries, and protection of the intellectual property of the "Personal Brand Architect" AI Service.</p>
      <p>Purpose of the document: To ensure the preservation of the unique "Author's Methodology" and to prevent any unauthorized use, copying, or creation of competing products based on the internal algorithms of the Service.</p>
      <p>This document regulates:</p>
      <ul class="list-disc ml-6 space-y-2 my-2">
        <li>The intellectual property status of the Owner and the Author;</li>
        <li>The scope and terms of the license granted to the User;</li>
        <li>Categorical prohibitions on reverse engineering and copying the Service's logic;</li>
        <li>Penalties for attempted commercial espionage or theft of the Methodology.</li>
      </ul>
      <p><strong>IMPORTANT:</strong> Any use of the Service (including undergoing the Audit and receiving Reports) constitutes the User's acknowledgement of these Rules. Violation of these Rules equates to a breach of the Offer terms and entails immediate blocking and legal prosecution.</p>
      <p><strong>ATTENTION:</strong> These Rules constitute an integral part of the Public Offer Agreement (Terms & Conditions), User Agreement, Privacy Policies, Affiliate Program Terms, and Instructions for using the Personal Account of the "Personal Brand Architect" Service. Acceptance of the Offer means that the User has <strong>read, understood, and unconditionally agreed</strong> to these Rules.</p>
    `,
  },
  {
    id: 'chapter-1',
    chapter: '1.',
    title: 'GENERAL PROVISIONS AND DEFINITIONS',
    content: `
      <p>1.1. These Rules establish the exclusive rights of the Owner and the Author to all intellectual property elements used in the Service, and also regulate the procedure for the User's use of Content and Methodology.</p>
      <p>1.2. Terms: The terms "Service", "Owner", "Author", "User", "Methodology", and "Acceptance of the Offer" are used in the meaning established in the Public Offer Agreement.</p>
      <p>1.3. Protected Content (IP): For the purposes of these Rules, Protected Content (Intellectual Property) refers to the following objects, the exclusive rights to which belong to the Owner and/or the Author:</p>
      <ul class="list-disc ml-6 space-y-2 my-2">
        <li>a) Methodology: The aggregate of algorithms, logical chains, the structure of 11 stages, templates, Terms of Reference (TOR), and other internal processes used by the Service to generate strategic documents.</li>
        <li>b) Question System (Intellectual Core): The aggregate of questions used by the Service at all stages, including:
          <ul class="list-disc ml-6 space-y-2 my-2">
             <li><strong>Static Core:</strong> Unique authorial questions formulated personally by the Author;</li>
             <li><strong>Adaptive Core:</strong> Dynamic questions generated by AI based on authorial prompts (instructions) and logical decision trees. The Parties acknowledge that the Adaptive Core is a technological derivative of the Static Core and the authorial algorithms. The Question System is regarded as a single indivisible object of intellectual property and commercial trade secret of the Owner.</li>
          </ul>
        </li>
        <li>c) Generated Content (Output Documents): Reports, terms of reference, financial models, business plans, and any other textual, graphical, or numerical documents generated by the Service specifically for the User.</li>
        <li>d) Design and Code: The entire design of the Service (visual layout) and the source program code.</li>
        <li>e) Affiliate Knowledge Base Content: Templates of texts, banners, video clips, promotion instructions, and other materials provided to Users with the status of "Partner" or "Ambassador" within the framework of the Affiliate Program Terms.</li>
      </ul>
    `,
  },
  {
    id: 'chapter-2',
    chapter: '2.',
    title: 'EXCLUSIVE RIGHTS AND LICENSE',
    content: `
      <p>2.1. Ownership of Rights: All rights to the Protected Content (IP), including, but not limited to, the author's methodology, copyrights, rights to know-how, and trade secrets, belong to the Owner and/or the Author in full.</p>
      <p>2.2. No Transfer of Rights: Acceptance of the Offer and payment for access to the Service do not imply the transfer to the User of any exclusive rights to the Methodology, Audit Questions, or the structure of the Service. The User is granted only a limited license to use the Service and its Output Documents.</p>
      <p>2.3. License for Output Documents (Generated Content): The Owner grants the User a non-exclusive, non-transferable, revocable, limited-term license to use the Generated Content (clause 1.3 c) exclusively for their personal entrepreneurial activity regarding the development of their own Personal Brand.</p>
      <ul class="list-disc ml-6 space-y-2 my-2">
        <li>The User is entitled to use, modify, publish, and demonstrate the Generated Content (e.g., Business Plan or TOR) for the purposes of implementing their own business.</li>
      </ul>
      <p>2.4. Reservation of Rights to Architecture and Structure: The User acknowledges that the Generated Content is the result of applying the unique "Author's Methodology". Despite the legal status of individual fragments of AI text, the Document Architecture (sequence of stages, logical interconnection of sections, unique headings, and TOR structure) is a protected IP object of the Owner.</p>
      <p>2.5. Protection of Generation Logic (Know-How): The User acknowledges that the prompts (instructions) controlling the AI constitute a commercial trade secret of the Owner. Any attempt to reveal the logic of generating adaptive questions through "Reverse Prompt Engineering" or analysis of AI response patterns is recognized as a violation of trade secrets.</p>
    `,
  },
  {
    id: 'chapter-3',
    chapter: '3.',
    title: 'CATEGORICAL PROHIBITIONS (IP INFRINGEMENT)',
    content: `
      <p>The User is <strong>categorically prohibited</strong> from performing the following actions regarding the Protected Content (IP):</p>
      <p>3.1. Copying of Methodology and Audit Questions: Any reproduction, copying, adaptation, decompilation, analysis, or creation of derivative works based on the following is prohibited:</p>
      <ul class="list-disc ml-6 space-y-2 my-2">
        <li>The structure, logic, and content of Audit Questions (Stage 1).</li>
        <li>The structure and logic of the Methodology (11 stages).</li>
        <li>The structure, headings, and content of Reports, TOR, and the Business Plan with the purpose of creating competing products.</li>
      </ul>
      <p>3.2. Creation of Competing Products: It is prohibited to use any elements of the Methodology and Audit Questions to create, develop, or promote any competing service, platform, online course, consulting or educational program aimed at the development or audit of Personal Brands.</p>
      <p>3.3. Restriction on Transfer to Third Parties: Transfer of Generated Content (TOR, strategies) to contractors is permitted exclusively in the volume minimally necessary to perform a specific task. The User is obliged to ensure the confidentiality of the data received on the part of their contractors. Transfer of the Methodology structure or Questions to third parties under the guise of "consultations" is prohibited.</p>
      <p>3.4. Reverse Engineering: Any attempt to gain access to the source code of the Service, its internal algorithms, or logical models is prohibited.</p>
      <p>3.5. Use for AI Training: The use of the Methodology or Audit Questions for training any third-party AI models or algorithms is prohibited.</p>
      <p>3.6. Misuse of Partner Base Content: Distribution, sale, transfer, copying, or use of the Affiliate Knowledge Base Content, including Templates, Banners, and Promotion Instructions, for any purposes other than the direct attraction of referrals and promotion of the "Personal Brand Architect" Service in strict accordance with the Affiliate Program Terms is prohibited.</p>
      <p>3.7. Prohibition on Automated Collection (Scraping): The use of any scripts, bots, or parser programs for the mass copying of Audit Questions, response structures, or Service logic is prohibited.</p>
    `,
  },
  {
    id: 'chapter-4',
    chapter: '4.',
    title: 'LIABILITY FOR IP INFRINGEMENT',
    content: `
      <p>4.1. Damage to Owner: Any violation of Section 3 of these Rules is recognized as a direct and material breach of the exclusive rights of the Owner and the Author, causing irreparable harm to the commercial value of the Service, and entails the infliction of significant damage, which is subject to recovery through judicial proceedings.</p>
      <p>4.2. Immediate Termination: The Owner has the right to immediately and without prior notice terminate the User's access to the Service (terminate the Agreement) without reimbursement, in the event of revealing facts of violation of these Rules.</p>
      <p>4.3. Legal Measures: The Owner reserves the right to use all available legal remedies provided by applicable law, including, but not limited to, claims for compensation of direct damages and lost profit, as well as the application of injunctive relief.</p>
      <p>4.4. Minimum Guaranteed Compensation (Liquidated Damages Floor): For each fact of violation of any of the prohibitions established in Section 3 of these Rules, the User undertakes to pay the Owner monetary compensation. The amount of such compensation is determined as the sum of all losses caused to the Owner (including direct damage and lost profit), but in any case cannot be less than 50,000 (fifty thousand) Euros for each separate fact of violation. The Parties confirm and agree that the specified minimum amount is a reasonable, fair, and pre-agreed estimate of the minimum possible damage caused to the commercial value of the Methodology and the intellectual rights of the Owner, considering the complexity and high cost of developing the Service.</p>
    `,
  },
  {
    id: 'chapter-5',
    chapter: '5.',
    title: 'GOVERNING LAW AND JURISDICTION',
    content: `
      <p>5.1. Applicable Law: These Rules, including all questions of interpretation, are governed exclusively by English Law.</p>
      <p>5.2. Jurisdiction: The exclusive jurisdiction for the resolution of any disputes related to the infringement of Intellectual Property is established as the High Court of Justice in London, England.</p>
    `,
  },
];

const blogItems = await getLatestAdvantagesPosts('en', 2);
const tocItems: TocItem[] = chapters.map((item) => ({
  id: item.id,
  text: item.title,
  chapter: item.chapter,
}));
---

<PageLayout head={page.meta} hero={page.hero}>
  <Section variant="default">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-8 lg:gap-12">
      <Sidebar
        tocItems={tocItems}
        blogItems={blogItems}
        blogTitle="Useful Materials"
        ctaText="Read more"
        class="order-last lg:order-first"
      />
      <div class="flex flex-col gap-8">
        <Breadcrumbs items={[{ text: content.breadcrumb }]} class="mb-6" />
        <div class="prose dark:prose-invert max-w-none">
          <div class="py-4">
            <p><strong>CONTENT USAGE RULES for the AI service "Personal Brand Architect"</strong></p>
            <p>Last updated date: 20.02.2026</p>
            <p>Effective from: 20.02.2026</p>
          </div>
          <Content chapters={chapters} />
        </div>
      </div>
    </div>
  </Section>
</PageLayout>
