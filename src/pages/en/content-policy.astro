---
import PageLayout from '@layouts/PageLayout.astro';
import Section from '@components/blocks/Section.astro';
import Sidebar from '@components/blocks/Sidebar.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import Content from '@components/blocks/Content.astro';
import { getPageContent } from '@data/pages';
import { getLatestAdvantagesPosts } from '@utils/posts';
import { getLegalPageContent } from '@data/page-content';
import { SUPPORTED_LANGUAGES } from '@/types/i18n';
import type { TocItem } from '@components/structures/TableOfContents.astro';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const page = getPageContent('contentPolicy', 'en');
const content = getLegalPageContent('contentPolicy', 'en');

const chapters = [
  {
    id: 'preamble',
    chapter: '',
    title: 'PREAMBLE (PURPOSE OF THE DOCUMENT)',
    content: `
      <p>This document (Content Usage Rules) is a legally binding agreement regulating access rights, usage limits, and intellectual property protection of the AI service "Personal Brand Architect".</p>
      <p>Purpose of the document: To ensure the safety of the unique "Author's Methodology" and prevent any unauthorized use, copying, or creation of competing products based on the Service's internal algorithms.</p>
      <p>This document regulates:</p>
      <ul class="list-disc ml-6 space-y-2 my-2">
        <li>Status of the Owner's and Author's intellectual property;</li>
        <li>Scope and conditions of the license granted to the User;</li>
        <li>Categorical bans on reverse engineering and copying the Service's logic;</li>
        <li>Penalties for attempted commercial espionage or theft of the Methodology.</li>
      </ul>
      <p><strong>IMPORTANT:</strong> Any use of the Service (including passing the Audit and receiving Reports) constitutes the User's acknowledgement of these Rules. Violation of these Rules equates to a breach of the Offer terms and entails immediate blocking and legal prosecution.</p>
      <p><strong>ATTENTION:</strong> These Rules are an integral part of the Public Offer Agreement (Terms & Conditions), User Agreement, Privacy Policies, Affiliate Program Terms, and the "Personal Brand Architect" Service Personal Account Usage Instructions. Acceptance of the Offer means that the User has read, understood, and unconditionally agreed to these Rules.</p>
    `,
  },
  {
    id: 'chapter-1',
    chapter: '1.',
    title: 'GENERAL PROVISIONS AND DEFINITIONS',
    content: `
      <p>1.1. These Rules establish the exclusive rights of the Owner and Author to all elements of intellectual property used in the Service, and regulate the procedure for the User's use of Content and Methodology.</p>
      <p>1.2. Terms: The terms "Service", "Owner", "Author", "User", "Methodology", and "Offer Acceptance" are used in the meaning established in the Public Offer Agreement.</p>
      <p>1.3. Protected Content (IP): For the purposes of these Rules, Protected Content (Intellectual Property) refers to the following objects, the exclusive rights to which belong to the Owner and/or Author:</p>
      <ul class="list-disc ml-6 space-y-2 my-2">
        <li>a) Methodology: A set of algorithms, logical chains, structure of 11 stages, templates, TOs (Technical Terms), and other internal processes used by the Service to generate strategic documents.</li>
        <li>b) Question System (Intellectual Core): A set of questions used by the Service at all stages, including:
          <ul class="list-disc ml-6 space-y-2 my-2">
             <li>Static core: Unique author's questions formulated personally by the Author;</li>
             <li>Adaptive core: Dynamic questions generated by AI based on author's prompts (instructions) and decision logic trees.</li>
          </ul>
          The Parties acknowledge that the Adaptive Core is a technological derivative of the Static Core and author's algorithms. The Question System is considered a single indivisible object of intellectual property and trade secret of the Owner.
        </li>
        <li>c) Generated Content (Output Documents): Reports, terms of reference, financial models, business plans, and any other text, graphic, or numerical documents generated by the Service specifically for the User.</li>
        <li>d) Design and Code: All Service design (visual styling) and source code.</li>
        <li>e) Affiliate Knowledge Base Content: Text templates, banners, videos, promotion instructions, and other materials provided to Users with "Partner" or "Ambassador" status within the Affiliate Program Terms.</li>
      </ul>
    `,
  },
  {
    id: 'chapter-2',
    chapter: '2.',
    title: 'EXCLUSIVE RIGHTS AND LICENSE',
    content: `
      <p>2.1. Ownership of Rights: All rights to Protected Content (IP), including but not limited to author's methodology, copyrights, rights to know-how and trade secrets, belong to the Owner and/or Author in full.</p>
      <p>2.2. No Transfer of Rights: Acceptance of the Offer and payment for access to the Service do not imply the transfer to the User of any exclusive rights to the Methodology, Stage Questions, or Service structure. The User is granted only a limited license to use the Service and its Output Documents.</p>
      <p>2.3. License for Output Documents (Generated Content): The Owner grants the User a non-exclusive, non-transferable, revocable, term-limited license to use the Generated Content (clause 1.3 c) exclusively for their personal entrepreneurial activity to develop their own Personal Brand.</p>
      <ul class="list-disc ml-6 space-y-2 my-2">
        <li>The User has the right to use, modify, publish, and demonstrate Generated Content (e.g., Business Plan or TO) for the purposes of implementing their own business.</li>
      </ul>
      <p>2.4. Retention of Rights to Architecture and Structure: The User acknowledges that Generated Content is the result of applying the unique "Author's Methodology". Despite the legal status of individual AI-text fragments, the Document Architecture (sequence of stages, logical relationship of sections, unique headings, and TO structure) is a protected IP object of the Owner.</p>
      <p>2.5. Protection of Generation Logic (Know-How): The User acknowledges that prompts (instructions) controlling the AI are the Owner's trade secret. Any attempt to reveal the logic of adaptive question generation through "Reverse Prompt Engineering" or analysis of AI response patterns is recognized as a violation of trade secrets.</p>
    `,
  },
  {
    id: 'chapter-3',
    chapter: '3.',
    title: 'CATEGORICAL PROHIBITIONS (IP VIOLATION)',
    content: `
      <p>The User is categorically prohibited from performing the following actions regarding Protected Content (IP):</p>
      <p>3.1. Copying Methodology and Audit Questions: Any reproduction, copying, adaptation, decompilation, analysis, or creation of derivative works based on:</p>
      <ul class="list-disc ml-6 space-y-2 my-2">
        <li>Structure, logic, and content of Audit Questions (Stage 1).</li>
        <li>Structure and logic of Methodology (11 stages).</li>
        <li>Structure, headings, and content of Reports, TOs, and Business Plans for the purpose of creating competing products.</li>
      </ul>
      <p>3.2. Creation of Competing Products: It is prohibited to use any elements of the Methodology and Audit Questions to create, develop, or promote any competing service, platform, online course, consulting or educational program aimed at developing or auditing Personal Brands.</p>
      <p>3.3. Restriction on Transfer to Third Parties: Transfer of Generated Content (TOs, strategies) to contractors is permitted exclusively in the volume minimally necessary to perform a specific task. The User is obliged to ensure the confidentiality of the data received by their contractors. Transfer of the Methodology structure or Questions to third parties under the guise of "consultations" is prohibited.</p>
      <p>3.4. Reverse Engineering: Any attempt to gain access to the Service's source code, its internal algorithms, or logical models is prohibited.</p>
      <p>3.5. Usage for AI Training: It is prohibited to use the Methodology or Audit Questions to train any third-party AI models or algorithms.</p>
      <p>3.6. Misuse of Partner Base Content: Distribution, sale, transfer, copying, or use of Affiliate Knowledge Base Content, including Templates, Banners, and Promotion Instructions, for any purposes other than direct referral attraction and promotion of the "Personal Brand Architect" Service in strict accordance with the Affiliate Program Terms is prohibited.</p>
      <p>3.7. Ban on Automated Collection (Scraping): Use of any scripts, bots, or parser programs for mass copying of Audit Questions, response structures, or Service logic is prohibited.</p>
    `,
  },
  {
    id: 'chapter-4',
    chapter: '4.',
    title: 'LIABILITY FOR IP VIOLATION',
    content: `
      <p>4.1. Damage to Owner: Any violation of clause 3 of these Rules is recognized as a direct and material violation of the exclusive rights of the Owner and Author, causing irreparable harm to the commercial value of the Service, and entails causing significant damage, which is subject to recovery in court.</p>
      <p>4.2. Immediate Termination: The Owner has the right to immediately and without prior notice terminate the User's access to the Service (terminate the Agreement) without reimbursement, in case of detection of facts of violation of these Rules.</p>
      <p>4.3. Legal Measures: The Owner reserves the right to use all available legal remedies provided by applicable law, including, but not limited to, claims for compensation for direct damages and lost profits, as well as applying for an injunction.</p>
      <p>4.4. Minimum Guaranteed Compensation (Liquidated Damages Floor): For each fact of violation of any of the prohibitions established in Section 3 of these Rules, the User undertakes to pay the Owner monetary compensation. The amount of such compensation is determined as the sum of all losses caused to the Owner (including direct damage and lost profits), but in any case cannot be less than 50,000 (fifty thousand) euros for each separate fact of violation. The Parties confirm and agree that the specified minimum amount is a reasonable, fair, and pre-agreed estimate of the minimum possible damage caused to the commercial value of the Methodology and the Owner's intellectual rights, considering the complexity and high cost of Service development.</p>
    `,
  },
  {
    id: 'chapter-5',
    chapter: '5.',
    title: 'GOVERNING LAW AND JURISDICTION',
    content: `
      <p>5.1. Applicable Law: These Rules, including all questions of interpretation, are governed exclusively by English Law.</p>
      <p>5.2. Jurisdiction: The High Court of Justice in London, England is established as the exclusive jurisdiction for resolving any disputes related to Intellectual Property violation.</p>
    `,
  },
];

const blogItems = await getLatestAdvantagesPosts('en', 2);
const tocItems: TocItem[] = chapters.map((item) => ({
  id: item.id,
  text: item.title,
  chapter: item.chapter,
}));
---

<PageLayout head={page.meta} hero={page.hero}>
  <Section variant="default">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-8 lg:gap-12">
      <Sidebar
        tocItems={tocItems}
        blogItems={blogItems}
        blogTitle="Useful Materials"
        ctaText="Read more"
        class="order-last lg:order-first"
      />
      <div class="flex flex-col gap-8">
        <Breadcrumbs items={[{ text: content.breadcrumb }]} class="mb-6" />
        <div class="prose dark:prose-invert max-w-none">
          <div class="py-4">
            <p><strong>CONTENT USAGE RULES for the AI service "Personal Brand Architect"</strong></p>
            <p>Last updated date: 20.02.2026</p>
            <p>Effective from: 20.02.2026</p>
          </div>
          <Content chapters={chapters} />
        </div>
      </div>
    </div>
  </Section>
</PageLayout>
