---
import HomeLayout from '@layouts/HomeLayout.astro';
import Hero from '@components/blocks/Hero.astro';
import Section from '@components/blocks/Section.astro';
import Content from '@components/blocks/Content.astro';
import Sidebar from '@components/blocks/Sidebar.astro';
import Card from '@components/ui/Card.astro';
import Heading from '@components/ui/Heading.astro';
import Paragraph from '@components/ui/Paragraph.astro';
import Button from '@components/ui/Button.astro';
import Image from '@components/ui/Image.astro';
import Accordion from '@components/ui/Accordion.astro';
import AdvantagesList from '@components/structures/AdvantagesList.astro';
import LaunchSteps from '@components/structures/LaunchSteps.astro';
import Reviews from '@components/structures/Reviews.astro';
import { useTranslations } from '@i18n/utils';
import { reviewsEn } from '@data/reviews';
import { getLatestBlogPosts } from '@utils/posts';

const t = useTranslations('en');

// Table of Contents items
const tocItems = [
  { id: 'chapter-1', chapter: 'Chapter 1', text: t('chapter1.title') },
  { id: 'chapter-2', chapter: 'Chapter 2', text: t('chapter2.title') },
  { id: 'chapter-3', chapter: 'Chapter 3', text: t('chapter3.title') },
  { id: 'chapter-4', chapter: 'Chapter 4', text: t('chapter4.title') },
  { id: 'chapter-5', chapter: 'Chapter 5', text: t('chapter5.title') },
];

// Content chapters
const chapters = [
  { id: 'chapter-1', chapter: t('chapter1.label'), title: t('chapter1.title'), content: t('chapter1.content') },
  { id: 'chapter-2', chapter: t('chapter2.label'), title: t('chapter2.title'), content: t('chapter2.content') },
  { id: 'chapter-3', chapter: t('chapter3.label'), title: t('chapter3.title'), content: t('chapter3.content') },
  { id: 'chapter-4', chapter: t('chapter4.label'), title: t('chapter4.title'), content: t('chapter4.content') },
  { id: 'chapter-5', chapter: t('chapter5.label'), title: t('chapter5.title'), content: t('chapter5.content') },
];

// Blog items for sidebar (fetched dynamically)
const blogItems = await getLatestBlogPosts('en', 2);

// Advantages
const advantages = [
  {
    icon: '/src/assets/images/advantages/1.webp',
    title: t('advantage1.title'),
    description: t('advantage1.description'),
    secondaryDescription: t('advantage1.secondary'),
  },
  {
    icon: '/src/assets/images/advantages/2.webp',
    title: t('advantage2.title'),
    description: t('advantage2.description'),
    secondaryDescription: t('advantage2.secondary'),
  },
  {
    icon: '/src/assets/images/advantages/3.webp',
    title: t('advantage3.title'),
    description: t('advantage3.description'),
    secondaryDescription: t('advantage3.secondary'),
  },
  {
    icon: '/src/assets/images/advantages/4.webp',
    title: t('advantage4.title'),
    description: t('advantage4.description'),
    secondaryDescription: t('advantage4.secondary'),
  },
];

// Launch Steps
const launchSteps = [
  {
    step: 1,
    icon: '/src/assets/images/steps-to-create-business/1-audit.webp',
    title: t('step1.title'),
    description: t('step1.description'),
  },
  {
    step: 2,
    icon: '/src/assets/images/steps-to-create-business/2-positioning.webp',
    title: t('step2.title'),
    description: t('step2.description'),
  },
  {
    step: 3,
    icon: '/src/assets/images/steps-to-create-business/3-monetization.webp',
    title: t('step3.title'),
    description: t('step3.description'),
  },
  {
    step: 4,
    icon: '/src/assets/images/steps-to-create-business/4-create-product.webp',
    title: t('step4.title'),
    description: t('step4.description'),
  },
  {
    step: 5,
    icon: '/src/assets/images/steps-to-create-business/5-research.webp',
    title: t('step5.title'),
    description: t('step5.description'),
  },
  {
    step: 6,
    icon: '/src/assets/images/steps-to-create-business/6-pack.webp',
    title: t('step6.title'),
    description: t('step6.description'),
  },
  {
    step: 7,
    icon: '/src/assets/images/steps-to-create-business/7-content-strategy.webp',
    title: t('step7.title'),
    description: t('step7.description'),
  },
  {
    step: 8,
    icon: '/src/assets/images/steps-to-create-business/8-strategy.webp',
    title: t('step8.title'),
    description: t('step8.description'),
  },
  {
    step: 9,
    icon: '/src/assets/images/steps-to-create-business/9-business-plan.webp',
    title: t('step9.title'),
    description: t('step9.description'),
  },
  {
    step: 10,
    icon: '/src/assets/images/steps-to-create-business/10-content-production.webp',
    title: t('step10.title'),
    description: t('step10.description'),
  },
];

// FAQ items
const faqItems = [
  { question: t('faq1.question'), answer: t('faq1.answer') },
  { question: t('faq2.question'), answer: t('faq2.answer') },
  { question: t('faq3.question'), answer: t('faq3.answer') },
  { question: t('faq4.question'), answer: t('faq4.answer') },
  { question: t('faq5.question'), answer: t('faq5.answer') },
];
---

<HomeLayout
  head={{
    title: 'Architect of Personal Brands - Create your online business',
    description: 'AI-service for creating a personal brand and online business in 10 steps',
  }}
>
  <!-- Hero Section -->
  <Hero layout="home" backgroundImage="/src/assets/images/bg-1.webp" globusImage="/src/assets/images/globus.webp">
    <div class="flex flex-col gap-4 items-center justify-center h-full text-center">
      <div class="text-sm text-muted-foreground uppercase tracking-wider font-medium">
        {t('hero.tagline')}
      </div>
      <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight">
        {t('hero.title')}
      </h1>
      <div class="mt-4 transform rotate-3">
        <a
          href="#steps"
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-white rounded-full transition-transform hover:scale-105 shadow-lg"
          style="background-color: #2470FF;"
        >
          {t('hero.cta')}
        </a>
      </div>
    </div>
  </Hero>

  <!-- About Section with Sidebar -->
  <Section id="about" variant="default">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-8 lg:gap-12">
      <Sidebar tocItems={tocItems} blogItems={blogItems} blogTitle={t('sidebar.blogTitle')} ctaText="Read more" />
      <div class="flex flex-col gap-8">
        <Heading as="h2" size="4xl" text={t('about.sectionTitle')} />
        <Content chapters={chapters} />
        <Card direction="row" size="lg" class="bg-secondary">
          <div class="flex flex-col gap-2">
            <Heading as="h3" size="xl" text={t('cta.create.title')} />
            <Paragraph text={t('cta.create.subtitle')} muted />
          </div>
          <Button text={t('cta.create.button')} href="/login" variant="primary" size="lg" />
        </Card>
      </div>
    </div>
  </Section>

  <!-- Advantages Section -->
  <Section id="advantages" title={t('advantages.title')} subtitle={t('advantages.subtitle')} variant="dark">
    <AdvantagesList items={advantages} />
    <div class="mt-8 flex justify-center">
      <Card variant="gradient" direction="row" size="lg" class="max-w-3xl">
        <div class="flex flex-col gap-2">
          <Heading as="h3" size="xl" text={t('advantages.cta.title')} />
          <Paragraph text={t('advantages.cta.subtitle')} muted />
        </div>
        <Button text={t('advantages.cta.button')} href="/en/advantages" variant="primary" size="lg" />
      </Card>
    </div>
  </Section>

  <!-- Steps Section -->
  <Section id="steps" title={t('steps.title')} subtitle={t('steps.subtitle')} variant="default">
    <LaunchSteps
      items={launchSteps}
      stepLabel="Step"
      ctaStep={{
        title: t('steps.cta.title'),
        subtitle: t('steps.cta.subtitle'),
        buttonText: t('steps.cta.button'),
        buttonHref: '/en/how-it-works',
      }}
    />
  </Section>

  <!-- FAQ Section -->
  <Section id="faq" variant="default">
    <div class="grid grid-cols-1 lg:grid-cols-[2fr_3fr] gap-8 lg:gap-16">
      <div class="flex flex-col gap-4">
        <Heading as="h2" size="4xl" text={t('faq.title')} />
        <Paragraph text={t('faq.subtitle')} muted />
        <div class="mt-4">
          <Image src="/src/assets/images/pages/faq.webp" alt="FAQ" width={500} height={400} class="rounded-2xl" />
        </div>
        <div class="mt-4 flex justify-center lg:justify-start w-full">
          <Card variant="default" direction="row" size="md" class="w-full bg-primary">
            <div class="flex flex-col gap-1">
              <span class="text-lg font-bold text-white">Learn everything</span>
              <span class="text-sm text-white/80">How the AI-service "Architect of Personal Brands" works</span>
            </div>
            <Button
              text="More details"
              href="/en/how-it-works"
              variant="secondary"
              size="md"
              class="bg-white text-black hover:bg-white/90"
            />
          </Card>
        </div>
      </div>
      <Accordion items={faqItems} />
    </div>
  </Section>

  <!-- Reviews Section -->
  <Section id="reviews" title={t('reviews.title')} subtitle={t('reviews.subtitle')} variant="dark">
    <Reviews reviews={reviewsEn} />
    <div class="mt-8 flex justify-center">
      <Card variant="gradient" direction="row" size="lg" class="max-w-3xl">
        <div class="flex flex-col gap-2">
          <Heading as="h3" size="xl" text={t('reviews.cta.title')} />
          <Paragraph text={t('reviews.cta.subtitle')} muted />
        </div>
        <Button text={t('reviews.cta.button')} href="/en/reviews" variant="primary" size="lg" />
      </Card>
    </div>
  </Section>
</HomeLayout>
