---
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/blocks/Hero.astro';
import Section from '@components/blocks/Section.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';

const title = 'Privacy Policy';
---

<PageLayout
  head={{
    title: `${title} - Architect of Personal Brands`,
    description: `Privacy Policy of Architect of Personal Brands`,
  }}
>
  <Hero layout="page" backgroundImage="/src/assets/images/bg-1.webp">
    <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight">{title}</h1>
  </Hero>

  <Section variant="default">
    <Breadcrumbs items={[{ text: title }]} class="mb-6" />
    <div class="prose dark:prose-invert max-w-none">
      <p>Privacy Policy content goes here.</p>
    </div>
  </Section>
</PageLayout>
