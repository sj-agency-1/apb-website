---
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/blocks/Hero.astro';
import Section from '@components/blocks/Section.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import Modal from '@components/structures/Modal.astro';
import { reviewsEn } from '@data/reviews';

const REVIEWS_PER_PAGE = 6;
---

<PageLayout
  head={{
    title: 'Reviews - Architect of Personal Brands',
    description: 'Read reviews from users who have created their Personal Brand business with our AI-service',
  }}
>
  <Hero layout="page" backgroundImage="/src/assets/images/bg-1.webp">
    <div class="flex flex-col gap-2">
      <div class="text-sm text-muted-foreground uppercase tracking-wider font-medium">
        AI-service Architect of Personal Brands
      </div>
      <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight">Reviews</h1>
    </div>
  </Hero>

  <Section id="reviews" variant="default">
    <Breadcrumbs items={[{ text: 'Reviews' }]} class="mb-6" />

    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl lg:text-3xl font-bold text-heading mb-2">What our users say</h2>
        <p class="text-foreground">
          Real reviews from people who have built their Personal Brand business with our AI-service
        </p>
      </div>
      <Button text="Leave a review" variant="primary" size="lg" class="leave-review-btn" />
    </div>

    <div id="reviews-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        reviewsEn.map((review, index) => (
          <Card
            variant="default"
            size="lg"
            class:list={['review-card flex flex-col h-full', { hidden: index >= REVIEWS_PER_PAGE }]}
            data-index={index}
          >
            <div class="flex items-start gap-4 mb-4">
              <img
                src={review.avatar}
                alt={review.name}
                width={64}
                height={64}
                class="w-16 h-16 rounded-full object-cover"
              />
              <div class="flex-1">
                <h3 class="font-semibold text-heading">{review.name}</h3>
                <p class="text-sm text-muted-foreground">
                  {review.age} years, {review.location}
                </p>
                {review.translated && (
                  <span class="inline-flex items-center gap-1 text-xs text-muted-foreground mt-1">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-3 h-3"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
                      />
                    </svg>
                    Translated
                  </span>
                )}
              </div>
            </div>
            <p class="text-foreground leading-relaxed flex-1">{review.text}</p>
          </Card>
        ))
      }
    </div>

    <div id="pagination" class="flex justify-center gap-2 mt-8">
      {
        Array.from({ length: Math.ceil(reviewsEn.length / REVIEWS_PER_PAGE) }).map((_, pageIndex) => (
          <button
            class:list={[
              'pagination-btn w-10 h-10 rounded-lg font-medium transition-colors',
              pageIndex === 0 ? 'bg-primary text-white' : 'bg-secondary text-foreground hover:bg-primary/20',
            ]}
            data-page={pageIndex}
          >
            {pageIndex + 1}
          </button>
        ))
      }
    </div>
  </Section>

  <Modal id="leave-review-modal" title="Leave a review">
    <div class="flex flex-col items-center text-center gap-6 py-4">
      <div class="w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-10 h-10 text-primary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
          ></path>
        </svg>
      </div>
      <div>
        <h3 class="text-xl font-semibold text-heading mb-2">Authorization required</h3>
        <p class="text-foreground mb-6">
          To leave a review, you need to log in to your account. Only verified users who have used our service can leave
          reviews.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 w-full">
        <Button text="Log in" href="/en/login" variant="primary" size="lg" class="flex-1" />
        <Button text="Register" href="/en/register" variant="outline" size="lg" class="flex-1" />
      </div>
    </div>
  </Modal>
</PageLayout>

<script define:vars={{ REVIEWS_PER_PAGE }}>
  document.addEventListener('DOMContentLoaded', () => {
    const reviewCards = document.querySelectorAll('.review-card');
    const paginationBtns = document.querySelectorAll('.pagination-btn');
    const leaveReviewBtn = document.querySelector('.leave-review-btn');

    // Pagination
    paginationBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const page = parseInt(btn.dataset.page || '0');
        const startIndex = page * REVIEWS_PER_PAGE;
        const endIndex = startIndex + REVIEWS_PER_PAGE;

        // Show/hide cards
        reviewCards.forEach((card, index) => {
          if (index >= startIndex && index < endIndex) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        // Update active button
        paginationBtns.forEach((b) => {
          b.classList.remove('bg-primary', 'text-white');
          b.classList.add('bg-secondary', 'text-foreground');
        });
        btn.classList.remove('bg-secondary', 'text-foreground');
        btn.classList.add('bg-primary', 'text-white');
      });
    });

    // Leave review modal
    if (leaveReviewBtn) {
      leaveReviewBtn.addEventListener('click', () => {
        if (typeof window.openModal === 'function') {
          window.openModal('leave-review-modal');
        }
      });
    }
  });
</script>
