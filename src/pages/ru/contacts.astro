---
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/blocks/Hero.astro';
import Section from '@components/blocks/Section.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import { contacts } from '@data/contacts';
---

<PageLayout
  head={{
    title: 'Контакты - Архитектор Личных Брендов',
    description: 'Свяжитесь с нами через Telegram, телефон или email',
  }}
>
  <Hero layout="page" backgroundImage="/src/assets/images/bg-1.webp">
    <div class="flex flex-col gap-2">
      <div class="text-sm text-muted-foreground uppercase tracking-wider font-medium">
        AI-сервис Архитектор Личных Брендов
      </div>
      <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight">Контакты</h1>
    </div>
  </Hero>

  <Section id="contacts" variant="default">
    <Breadcrumbs items={[{ text: 'Контакты' }]} class="mb-6" />

    <div class="mb-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-heading mb-4">Свяжитесь с нами</h2>
      <p class="text-foreground leading-relaxed">
        Есть вопросы или нужна помощь? Мы здесь, чтобы помочь. Выберите наиболее удобный способ связи.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <Card variant="default" size="lg" class="text-center">
        <div class="flex flex-col items-center gap-4 p-6">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-8 h-8 text-primary"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-heading mb-1">Telegram</h3>
            <p class="text-muted-foreground mb-4">Самый быстрый способ связи</p>
            <a
              href={contacts.telegramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary font-medium hover:underline"
            >
              {contacts.telegram}
            </a>
          </div>
        </div>
      </Card>

      <Card variant="default" size="lg" class="text-center">
        <div class="flex flex-col items-center gap-4 p-6">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-8 h-8 text-primary"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-heading mb-1">Телефон</h3>
            <p class="text-muted-foreground mb-4">Позвоните нам напрямую</p>
            <a href={contacts.phoneUrl} class="text-primary font-medium hover:underline">
              {contacts.phone}
            </a>
          </div>
        </div>
      </Card>

      <Card variant="default" size="lg" class="text-center">
        <div class="flex flex-col items-center gap-4 p-6">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-8 h-8 text-primary"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-heading mb-1">Email</h3>
            <p class="text-muted-foreground mb-4">Пишите нам в любое время</p>
            <a href={contacts.emailUrl} class="text-primary font-medium hover:underline">
              {contacts.email}
            </a>
          </div>
        </div>
      </Card>
    </div>

    <div class="bg-gradient-to-r from-primary/20 to-secondary rounded-2xl">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 p-8">
        <div>
          <h3 class="text-xl font-semibold text-heading mb-2">Нужна поддержка?</h3>
          <p class="text-foreground">Наша служба поддержки готова помочь вам с любыми вопросами о сервисе.</p>
        </div>
        <Button text="Связаться с поддержкой" href={contacts.telegramUrl} variant="primary" size="lg" target="_blank" />
      </div>
    </div>
  </Section>
</PageLayout>
