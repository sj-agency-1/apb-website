---
import PageLayout from '@layouts/PageLayout.astro';
import Section from '@components/blocks/Section.astro';
import Sidebar from '@components/blocks/Sidebar.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import Content from '@components/blocks/Content.astro';
import { getPageContent } from '@data/pages';
import { getLatestAdvantagesPosts } from '@utils/posts';
import { getLegalPageContent } from '@data/page-content';
import { SUPPORTED_LANGUAGES } from '@/types/i18n';
import type { TocItem } from '@components/structures/TableOfContents.astro';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const page = getPageContent('contentPolicy', 'ru');
const content = getLegalPageContent('contentPolicy', 'ru');

const chapters = [
  {
    id: 'preamble',
    chapter: '',
    title: 'ПРЕАМБУЛА (НАЗНАЧЕНИЕ ДОКУМЕНТА)',
    content: `
      <p>Настоящий документ (Правила использования контента) является юридически обязательным соглашением, регламентирующим права доступа, границы использования и защиту интеллектуальной собственности AI-сервиса «Архитектор Личных Брендов».</p>
      <p>Цель документа: Обеспечить сохранность уникальной «Методики Автора» и предотвратить любое несанкционированное использование, копирование или создание конкурирующих продуктов на основе внутренних алгоритмов Сервиса.</p>
      <p>Данный документ регламентирует:</p>
      <ul class="list-disc ml-6 space-y-2 my-2">
        <li>Статус интеллектуальной собственности Владельца и Автора;</li>
        <li>Объем и условия лицензии, предоставляемой Пользователю;</li>
        <li>Категорические запреты на реверс-инжиниринг и копирование логики Сервиса;</li>
        <li>Штрафные санкции за попытку коммерческого шпионажа или кражи Методики.</li>
      </ul>
      <p><strong>ВАЖНО:</strong> Любое использование Сервиса (включая прохождение Аудита и получение Отчетов) означает признание Пользователем данных Правил. Нарушение этих Правил приравнивается к нарушению условий Оферты и влечет за собой немедленную блокировку и судебное преследование.</p>
      <p><strong>ВНИМАНИЕ:</strong> Настоящие Правила являются неотъемлемой частью Договора Публичной Оферты (Terms & Conditions), Пользовательского Соглашения, Политик Конфиденциальности, Условий Партнерской Программы и Инструкции по использованию Личного Кабинета Сервиса «Архитектор Личных Брендов». Акцепт Оферты означает, что Пользователь прочитал, понял и безоговорочно согласился с данными Правилами.</p>
    `,
  },
  {
    id: 'chapter-1',
    chapter: '1.',
    title: 'ОБЩИЕ ПОЛОЖЕНИЯ И ОПРЕДЕЛЕНИЯ',
    content: `
      <p>1.1. Настоящие Правила устанавливают исключительные права Владельца и Автора на все элементы интеллектуальной собственности, используемые в Сервисе, а также регулируют порядок использования Контента и Методики Пользователем.</p>
      <p>1.2. Термины: Термины «Сервис», «Владелец», «Автор», «Пользователь», «Методика» и «Акцепт Оферты» используются в значении, установленном в Договоре Публичной Оферты.</p>
      <p>1.3. Защищаемый Контент (ИС): В целях настоящих Правил, под Защищаемым Контентом (Интеллектуальной Собственностью) понимаются следующие объекты, исключительные права на которые принадлежат Владельцу и/или Автору:</p>
      <ul class="list-disc ml-6 space-y-2 my-2">
        <li>а) Методика: Совокупность алгоритмов, логических цепочек, структуры 11 этапов, шаблонов, ТЗ и других внутренних процессов, используемых Сервисом для генерации стратегических документов.</li>
        <li>б) Система Вопросов (Интеллектуальное Ядро): Совокупность вопросов, используемых Сервисом на всех этапах, включая:
          <ul class="list-disc ml-6 space-y-2 my-2">
             <li>Статическое ядро: Уникальные авторские вопросы, сформулированные лично Автором;</li>
             <li>Адаптивное ядро: Динамические вопросы, генерируемые ИИ на основе авторских промптов (инструкций) и логических деревьев решений.</li>
          </ul>
          Стороны признают, что Адаптивное ядро является технологическим производным от Статического ядра и авторских алгоритмов. Система Вопросов рассматривается как единый неделимый объект интеллектуальной собственности и коммерческой тайны Владельца.
        </li>
        <li>в) Генерируемый Контент (Выходные Документы): Отчеты, технические задания, финансовые модели, бизнес-планы и любые иные текстовые, графические или числовые документы, сгенерированные Сервисом специально для Пользователя.</li>
        <li>г) Дизайн и Код: Весь дизайн Сервиса (визуальное оформление) и исходный программный код.</li>
        <li>д) Контент Партнерской Базы Знаний: Шаблоны текстов, баннеров, видеороликов, инструкции по продвижению и другие материалы, предоставляемые Пользователям со статусом «Партнер» или «Амбассадор» в рамках Условий Партнерской Программы.</li>
      </ul>
    `,
  },
  {
    id: 'chapter-2',
    chapter: '2.',
    title: 'ИСКЛЮЧИТЕЛЬНЫЕ ПРАВА И ЛИЦЕНЗИЯ',
    content: `
      <p>2.1. Принадлежность Прав: Все права на Защищаемый Контент (ИС), включая, но не ограничиваясь, авторскую методику, авторские права, права на ноу-хау и коммерческую тайну, принадлежат Владельцу и/или Автору в полном объеме.</p>
      <p>2.2. Отсутствие Передачи Прав: Акцепт Оферты и оплата доступа к Сервису не означают передачу Пользователю каких-либо исключительных прав на Методику, Вопросы этапов или структуру Сервиса. Пользователю передается только ограниченная лицензия на использование Сервиса и его Выходных Документов.</p>
      <p>2.3. Лицензия на Выходные Документы (Генерируемый Контент): Владелец предоставляет Пользователю неисключительную, непередаваемую, отзывную, срочную лицензию на использование Генерируемого Контента (п. 1.3 в) исключительно для его личной предпринимательской деятельности по развитию собственного Личного Бренда.</p>
      <ul class="list-disc ml-6 space-y-2 my-2">
        <li>Пользователь вправе использовать, изменять, публиковать и демонстрировать Генерируемый Контент (например, Бизнес-план или ТЗ) для целей реализации собственного бизнеса.</li>
      </ul>
      <p>2.4. Сохранение прав на Архитектуру и Структуру: Пользователь признает, что Генерируемый Контент является результатом применения уникальной «Методики Автора». Несмотря на правовой статус отдельных фрагментов ИИ-текста, Архитектура Документа (последовательность этапов, логическая взаимосвязь разделов, уникальные заголовки и структура ТЗ) является охраняемым объектом ИС Владельца.</p>
      <p>2.5. Защита логики генерации (Know-How): Пользователь признает, что промпты (инструкции), управляющие ИИ, являются коммерческой тайной Владельца. Любая попытка выявить логику генерации адаптивных вопросов путем «Reverse Prompt Engineering» или анализа закономерностей ответов ИИ признается нарушением коммерческой тайны.</p>
    `,
  },
  {
    id: 'chapter-3',
    chapter: '3.',
    title: 'КАТЕГОРИЧЕСКИЕ ЗАПРЕТЫ (НАРУШЕНИЕ ИС)',
    content: `
      <p>Пользователю категорически запрещено совершать следующие действия в отношении Защищаемого Контента (ИС):</p>
      <p>3.1. Копирование Методики и Вопросов Аудита: Запрещено любое воспроизведение, копирование, адаптация, декомпиляция, анализ или создание производных работ на основе:</p>
      <ul class="list-disc ml-6 space-y-2 my-2">
        <li>Структуры, логики и содержания Вопросов Аудита (Этап 1).</li>
        <li>Структуры и логики Методики (11 этапов).</li>
        <li>Структуры, заголовков и содержания Отчетов, ТЗ и Бизнес-плана с целью создания конкурирующих продуктов.</li>
      </ul>
      <p>3.2. Создание Конкурирующих Продуктов: Запрещено использовать любые элементы Методики и Вопросов Аудита для создания, разработки или продвижения любого конкурирующего сервиса, платформы, онлайн-курса, консалтинговой или обучающей программы, направленной на разработку или аудит Личных Брендов.</p>
      <p>3.3. Ограничение передачи третьим лицам: Передача Генерируемого Контента (ТЗ, стратегий) подрядчикам разрешена исключительно в объеме, минимально необходимом для выполнения конкретной задачи. Пользователь обязан обеспечить конфиденциальность полученных данных со стороны своих подрядчиков. Запрещена передача структуры Методики или Вопросов третьим лицам под видом «консультаций».</p>
      <p>3.4. Обратное Проектирование (Reverse Engineering): Запрещена любая попытка получить доступ к исходному коду Сервиса, его внутренним алгоритмам или логическим моделям.</p>
      <p>3.5. Использование для Обучения AI: Запрещено использование Методики или Вопросов Аудита для обучения любых сторонних AI-моделей или алгоритмов.</p>
      <p>3.6. Нецелевое Использование Контента Партнерской Базы: Запрещается распространение, продажа, передача, копирование или использование Контента Партнерской Базы Знаний, включая Шаблоны, Баннеры и Инструкции по Продвижению, в любых целях, кроме непосредственного привлечения рефералов и продвижения Сервиса «Архитектор Личных Брендов» в строгом соответствии с Условиями Партнерской Программы.</p>
      <p>3.7. Запрет на автоматизированный сбор (Scraping): Запрещено использование любых скриптов, ботов или программ-парсеров для массового копирования Вопросов Аудита, структуры ответов или логики Сервиса.</p>
    `,
  },
  {
    id: 'chapter-4',
    chapter: '4.',
    title: 'ОТВЕТСТВЕННОСТЬ ЗА НАРУШЕНИЕ ИС',
    content: `
      <p>4.1. Ущерб Владельца: Любое нарушение п. 3 настоящих Правил признается прямым и существенным нарушением исключительных прав Владельца и Автора, наносящее невосполнимый вред коммерческой ценности Сервиса, и влечет за собой причинение значительного ущерба, который подлежит взысканию в судебном порядке.</p>
      <p>4.2. Немедленное Расторжение: Владелец имеет право немедленно и без предварительного уведомления прекратить доступ Пользователя к Сервису (расторгнуть Соглашение) без возмещения, в случае выявления фактов нарушения настоящих Правил.</p>
      <p>4.3. Юридические Меры: Владелец оставляет за собой право использовать все доступные средства правовой защиты, предусмотренные применимым правом, включая, но не ограничиваясь, требование о возмещении прямого ущерба и упущенной выгоды, а также применение судебного запрета.</p>
      <p>4.4. Минимально гарантированное возмещение (Liquidated Damages Floor): За каждый факт нарушения любого из запретов, установленных в Разделе 3 настоящих Правил, Пользователь обязуется выплатить Владельцу денежную компенсацию. Размер такой компенсации определяется как сумма всех причиненных Владельцу убытков (включая прямой ущерб и упущенную выгоду), но в любом случае не может составлять менее 50 000 (пятидесяти тысяч) евро за каждый отдельный факт нарушения. Стороны подтверждают и соглашаются, что указанная минимальная сумма является разумной, справедливой и заранее согласованной оценкой минимально возможного ущерба, наносимого коммерческой ценности Методики и интеллектуальным правам Владельца, учитывая сложность и высокую стоимость разработки Сервиса.</p>
    `,
  },
  {
    id: 'chapter-5',
    chapter: '5.',
    title: 'ПРИМЕНИМОЕ ПРАВО И ЮРИСДИКЦИЯ',
    content: `
      <p>5.1. Применимое Право: Настоящие Правила, включая все вопросы толкования, регулируются исключительно Английским Правом.</p>
      <p>5.2. Юрисдикция: Исключительной юрисдикцией для разрешения любых споров, связанных с нарушением Интеллектуальной Собственности, устанавливается Высокий Суд Правосудия в Лондоне, Англия (High Court of Justice in London, England).</p>
    `,
  },
];

const blogItems = await getLatestAdvantagesPosts('ru', 2);
const tocItems: TocItem[] = chapters.map((item) => ({
  id: item.id,
  text: item.title,
  chapter: item.chapter,
}));
---

<PageLayout head={page.meta} hero={page.hero}>
  <Section variant="default">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-8 lg:gap-12">
      <Sidebar
        tocItems={tocItems}
        blogItems={blogItems}
        blogTitle="Полезные материалы"
        ctaText="Подробнее"
        class="order-last lg:order-first"
      />
      <div class="flex flex-col gap-8">
        <Breadcrumbs items={[{ text: content.breadcrumb }]} class="mb-6" />
        <div class="prose dark:prose-invert max-w-none">
          <div class="py-4">
            <p><strong>ПРАВИЛА ИСПОЛЬЗОВАНИЯ КОНТЕНТА AI-сервиса «Архитектор Личных Брендов»</strong></p>
            <p>Дата последнего обновления: 20.02.2026</p>
            <p>Действует с: 20.02.2026</p>
          </div>
          <Content chapters={chapters} />
        </div>
      </div>
    </div>
  </Section>
</PageLayout>
