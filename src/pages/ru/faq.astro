---
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/blocks/Hero.astro';
import Section from '@components/blocks/Section.astro';
import Sidebar from '@components/blocks/Sidebar.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import Accordion from '@components/ui/Accordion.astro';
import { faqPageItemsRu } from '@data/faq';
import { getLatestBlogPosts } from '@utils/posts';

const blogPosts = await getLatestBlogPosts('ru', 2);
---

<PageLayout
  head={{
    title: 'FAQ - Архитектор Личных Брендов',
    description: 'Часто задаваемые вопросы об AI-сервисе Архитектор Личных Брендов',
  }}
>
  <Hero layout="page" backgroundImage="/src/assets/images/bg-1.webp">
    <div class="flex flex-col gap-2">
      <div class="text-sm text-muted-foreground uppercase tracking-wider font-medium">
        AI-сервис Архитектор Личных Брендов
      </div>
      <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight">FAQ</h1>
    </div>
  </Hero>

  <Section id="faq" variant="default">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-8">
      <div>
        <Breadcrumbs items={[{ text: 'FAQ' }]} class="mb-6" />

        <div class="mb-8">
          <h2 class="text-2xl lg:text-3xl font-bold text-heading mb-4">Часто задаваемые вопросы</h2>
          <p class="text-foreground leading-relaxed">
            Здесь вы найдете ответы на самые распространенные вопросы о нашем AI-сервисе. Если вы не нашли нужный ответ,
            свяжитесь с нами.
          </p>
        </div>

        <div class="space-y-4">
          <Accordion items={faqPageItemsRu.map((item) => ({ question: item.question, answer: item.answer }))} />
        </div>
      </div>

      <Sidebar blogItems={blogPosts} />
    </div>
  </Section>
</PageLayout>
