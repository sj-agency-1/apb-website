---
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/blocks/Hero.astro';
import Section from '@components/blocks/Section.astro';
import Breadcrumbs from '@components/structures/Breadcrumbs.astro';
import StepsAccordion from '@components/structures/StepsAccordion.astro';
import { getStepPricing } from '@data/pricing';

const steps = getStepPricing('ru');
---

<PageLayout
  head={{
    title: 'Как это работает - Архитектор Личных Брендов',
    description: '10 шагов к созданию вашего Личного Бренда-Бизнеса',
  }}
>
  <!-- Hero Section -->
  <Hero layout="page" backgroundImage="/src/assets/images/bg-1.webp">
    <div class="flex flex-col gap-2">
      <div class="text-sm text-muted-foreground uppercase tracking-wider font-medium">
        AI-сервис Архитектор Личных Брендов
      </div>
      <h1 class="text-4xl lg:text-5xl font-bold text-white leading-tight">Как это работает</h1>
    </div>
  </Hero>

  <!-- Content Section -->
  <Section id="how-it-works" variant="default">
    <Breadcrumbs items={[{ text: 'Как это работает' }]} class="mb-6" />

    <div class="mb-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-heading mb-4">
        10 шагов к созданию вашего Личного Бренда-Бизнеса
      </h2>
      <p class="text-foreground leading-relaxed">
        AI-сервис «Архитектор Личных Брендов» — это не просто инструкция, а пошаговый маршрут, который ведет вас от
        самопознания до создания полноценного и прибыльного бизнеса. Весь процесс состоит из 10 ключевых этапов,
        проработанных до мельчайших деталей.
      </p>
    </div>

    <div class="mb-6">
      <h3 class="text-lg font-semibold text-heading mb-2">Вот как выглядит этот путь:</h3>
    </div>

    <StepsAccordion
      items={steps}
      stepLabel="Этап"
      descriptionLabel="Описание"
      purposeLabel="Для чего этот этап"
      faqLabel="Часто задаваемые Вопросы"
      priceLabel="Стоимость"
      promoPriceLabel="Стоимость по промокоду"
    />
  </Section>
</PageLayout>
