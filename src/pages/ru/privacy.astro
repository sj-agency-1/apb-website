const blogItems = await getLatestAdvantagesPosts('ru', 2);
const tocItems: TocItem[] = chapters.map((item) => ({
  id: item.id,
  text: item.title,
  chapter: item.chapter,
}));
---

<PageLayout head={page.meta} hero={page.hero}>
  <Section variant="default">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-8 lg:gap-12">
      <Sidebar
        tocItems={tocItems}
        blogItems={blogItems}
        blogTitle="Полезные материалы"
        ctaText="Подробнее"
        class="order-last lg:order-first"
      />
      <div class="flex flex-col gap-8">
        <Breadcrumbs items={[{ text: content.breadcrumb }]} class="mb-6" />
        <div class="prose dark:prose-invert max-w-none">
          <div class="py-4">
            <p><strong>ПОЛИТИКА КОНФИДЕНЦИАЛЬНОСТИ (PRIVACY POLICY) AI-сервиса «Архитектор Личных Брендов»</strong></p>
            <p>Дата вступления в силу: 20.02.2026</p>
            <p>Дата последнего обновления: 20.02.2026</p>
            <p>
              <strong>ПРЕАМБУЛА (ВВЕДЕНИЕ)</strong><br />
              Настоящая Политика Конфиденциальности (далее — «Политика») разъясняет, как Сервис собирает, использует, хранит
              и защищает ваши данные. ВАЖНО: Разработка личного бренда через ИИ связана с передачей чувствительной информации,
              поэтому целью SaaS-платформы «Архитектор Личных Брендов» является обеспечение прозрачности обработки данных
              Пользователя и их защита через механизмы анонимизации, шифрования и использование защищенных каналов передачи
              данных (Enterprise API). Пользуясь Сервисом, Пользователь доверяет свои персональные данные. Если Пользователь
              не согласен с методами обработки, описанными в настоящем документе, то он должен прекратить использование Платформы.
              Настоящая Политика является юридически обязательным дополнением к Договору Оферты и Пользовательскому Соглашению.
            </p>
          </div>
          <Content chapters={chapters} />
        </div>
      </div>
    </div>
  </Section>
</PageLayout>
